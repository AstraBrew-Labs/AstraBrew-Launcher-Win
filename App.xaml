<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AstraBrew_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AstraBrew_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                品牌资产按主题切换：浅色用深色描线版本，深色用白色版本。
                图片本身就是单色透明底，换成对应色才不会在同一背景上看不见。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-light.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-light.png" />
                    <!--  标题栏实例徽章：浅色背景需要更深的蓝才够对比  -->
                    <SolidColorBrush x:Key="InstanceChipBackgroundBrush" Color="#1F2B88D8" />
                    <SolidColorBrush x:Key="InstanceChipForegroundBrush" Color="#FF1B6CB8" />
                    <!--  全局消息卡：浮在内容之上，必须不透明，否则会和下面的卡片糊成一片  -->
                    <SolidColorBrush x:Key="NotifySurfaceBrush" Color="#FFFAFAFC" />
                    <SolidColorBrush x:Key="NotifyStrokeBrush" Color="#22000000" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-dark.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-dark.png" />
                    <!--  深色背景：蓝字提亮到 12px 小字也能读清  -->
                    <SolidColorBrush x:Key="InstanceChipBackgroundBrush" Color="#244CC2FF" />
                    <SolidColorBrush x:Key="InstanceChipForegroundBrush" Color="#FF7CC7F5" />
                    <!--  深色下的消息卡比卡片再亮一档，才压得住下面的内容  -->
                    <SolidColorBrush x:Key="NotifySurfaceBrush" Color="#FF2C2C31" />
                    <SolidColorBrush x:Key="NotifyStrokeBrush" Color="#26FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-dark.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-dark.png" />
                    <SolidColorBrush x:Key="InstanceChipBackgroundBrush" Color="#1F2B88D8" />
                    <SolidColorBrush x:Key="InstanceChipForegroundBrush" Color="#FF2B88D8" />
                    <!--  高对比度：消息卡直接压在系统窗口底色上，靠粗描边分层  -->
                    <SolidColorBrush x:Key="NotifySurfaceBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="NotifyStrokeBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
