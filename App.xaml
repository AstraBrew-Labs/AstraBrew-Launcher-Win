<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AstraBrew_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AstraBrew_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                品牌资产按主题切换：浅色用深色描线版本，深色用白色版本。
                图片本身就是单色透明底，换成对应色才不会在同一背景上看不见。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-light.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-light.png" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-dark.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-dark.png" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <BitmapImage x:Key="BrandIconSource" UriSource="ms-appx:///Assets/brand-icon-dark.png" />
                    <BitmapImage x:Key="BrandLockupSource" UriSource="ms-appx:///Assets/brand-lockup-dark.png" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
