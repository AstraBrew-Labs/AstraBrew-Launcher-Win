<?xml version="1.0" encoding="utf-8"?>
<!--
  安装包外壳（Burn 引导程序）。

  只做一件事：把同目录那份 MSI 串起来，给用户一个双击就能装、带进度与许可页的 setup.exe。
  真正的安装逻辑全在 MSI 里，这层不重复造。

  参数：
    -d MsiPath       上一步产出的 msi 路径
    -d BundleVersion 四段数字版本（例如 0.3.0.0），Burn 只认纯数字
    -d DisplayName   产品显示名
    -d IconPath      setup.exe 的图标
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle
      Name="$(var.DisplayName)"
      Version="$(var.BundleVersion)"
      Manufacturer="AstraBrew Labs"
      UpgradeCode="C1B7E4A9-6D38-4F52-B0E7-2A9C5D3F81B6"
      IconSourceFile="$(var.IconPath)"
      Compressed="yes">

    <BootstrapperApplication>
      <!--  许可读线上那份：包里不带 rtf，改协议不用重发安装包  -->
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://launcher.astrabrew.cn/license"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" Vital="yes" />
    </Chain>

  </Bundle>

</Wix>
