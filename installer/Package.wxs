<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI 定义。**单包同时支持「为所有人安装」与「仅为当前用户安装」**
（WiX 叫 perUserOrMachine），由安装向导第一页让用户选。

  默认落点：
    · 所有人     → C:\Program Files\AstraBrew Launcher（写 HKLM，公共桌面/开始菜单）
    · 当前用户   → %LocalAppData%\Programs\AstraBrew Launcher（写 HKCU，用户桌面/开始菜单）
  两处都在向导里可改；改过的路径会在安装时记进注册表（InstallLocation），
  卸载靠 AppSearch 读回来，否则卸载会跑去默认目录删、把实际文件留在盘上。

  由 tools/package.ps1 调用，参数：
    -d PublishDir     发布目录（已裁剪好的待打包文件树）
    -d ProductVersion MSI 的 ProductVersion，必须是纯数字 a.b.c
    -d DisplayName    产品显示名（非正式版带渠道后缀，方便测试机分辨装了哪一条线）
    -d IconPath       控制面板「应用和功能」里那条记录用的图标

  界面**不在 MSI 里**：安装向导由 installer/Setup 自己画（Tauri 2 / NSIS 那种版式），
  以静默方式驱动这个包（INSTALLFOLDER / ALLUSERS / MSIINSTALLPERUSER 都是公开属性）。
  所以这里不要挂 WixUI——挂了反而会让 msiexec 自己弹出一套老式对话框。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
      >

  <Package
      Name="$(var.DisplayName)"
      Manufacturer="AstraBrew Labs"
      Version="$(var.ProductVersion)"
      UpgradeCode="8E4C1D5A-2F3B-4C7D-9A18-6B2E5F0C7D31"
      Scope="perUserOrMachine"
      Language="2052"
      Codepage="936"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation
        Description="$(var.DisplayName)"
        Manufacturer="AstraBrew Labs" />

    <!--  同一条渠道升版直接覆盖；装更老的包时拦住，免得把新文件换成旧的  -->
    <MajorUpgrade DowngradeErrorMessage="已经装了更新的版本，请先在「设置 → 应用 → 已安装的应用」里卸载它。" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      卸载时是否连用户数据一起删。**默认 0 = 保留**：
      静默卸载、或用户没回答，都不会动数据。只有向导里明确点了「是」才置 1。
    -->
    <Property Id="REMOVEUSERDATA" Value="0" Secure="yes" />

    <!--  「应用和功能」里的位置列：值填进去要经 SetProperty，直接写属性引用会被 WIX1077 拦  -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" Before="CostFinalize" Sequence="both" />

    <!--
      安装路径记录 → 卸载时读回来。用户可能把程序装到 D 盘，卸载必须照着注册表里的实际路径删，
      否则 MSI 只会去默认目录找，文件全留在盘上。

      只搜 HKCU：两个作用域安装时都会往 HKCU 记一份（见 RegistryMachine / RegistryUser 组件），
      这样一条搜索就能覆盖两种情况，不必让两条搜索去抢同一个属性。
    -->
    <Property Id="INSTALLLOCATION">
      <RegistrySearch
          Id="SearchInstallLocation"
          Root="HKCU"
          Key="Software\AstraBrew Labs\AstraBrew Launcher"
          Name="InstallLocation"
          Type="raw" />
    </Property>
    <SetProperty
        Id="INSTALLFOLDER"
        Value="[INSTALLLOCATION]"
        Before="CostFinalize"
        Sequence="both"
        Condition="INSTALLLOCATION" />

    <!--  ==================== 目录 ====================  -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AstraBrew Launcher" />
    </StandardDirectory>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <!--  仅当前用户安装时的默认落点  -->
        <Directory Id="INSTALLFOLDERPERUSER" Name="AstraBrew Launcher" />
      </Directory>
      <!--  用户数据：%LocalAppData%\AstraBrew Launcher（缓存、更新包、运行时）  -->
      <Directory Id="LOCALDATA" Name="AstraBrew Launcher" />
    </StandardDirectory>

    <!--  用户数据：%AppData%\AstraBrew Launcher（设置、实例清单）  -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="ROAMINGDATA" Name="AstraBrew Launcher" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="AstraBrew Launcher" />
    </StandardDirectory>

    <!--  桌面快捷方式：ALLUSERS=1 时自动落到公共桌面  -->
    <StandardDirectory Id="DesktopFolder" />

    <!--  ==================== 功能 ====================  -->
    <Feature Id="Main" Title="$(var.DisplayName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ShellIntegration" />
      <ComponentGroupRef Id="RegistryUser" />
    </Feature>


  </Package>



  <!--  程序文件：按目录树自动生成组件  -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <!--  ==================== 快捷方式 ====================  -->
  <Fragment>
    <ComponentGroup Id="ShellIntegration">

      <!--  开始菜单：ALLUSERS=1 时 ProgramMenuFolder 自动落到「所有用户」的开始菜单  -->
      <Component Id="StartMenuShortcut" Directory="ShortcutFolder" Guid="3A7F9C22-5D14-4B8E-A6C3-91E0F2B45D77">
        <Shortcut
            Id="AppShortcut"
            Name="AstraBrew Launcher"
            Description="星酿启动器"
            Target="[INSTALLFOLDER]AstraBrew Launcher.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

      <!--  桌面快捷方式：DesktopFolder 同样随 ALLUSERS 落到公共桌面或用户桌面  -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="B47E2C19-8A5D-4E63-9F21-7C0A4B8D5E92">
        <Shortcut
            Id="DesktopAppShortcut"
            Name="AstraBrew Launcher"
            Description="星酿启动器"
            Target="[INSTALLFOLDER]AstraBrew Launcher.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!--  ==================== 注册表：按作用域二选一 ====================  -->
  <Fragment>
    <ComponentGroup Id="RegistryUser">

      <Component Id="InstallLocationUser" Directory="INSTALLFOLDER" Guid="4F82A6C7-71B3-4D95-9E42-8B6A0F5C3D18">
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="InstallLocation"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="Installed"
            Type="integer"
            Value="1" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="RoamingData"
            Type="string"
            Value="[ROAMINGDATA]" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AstraBrew Labs\AstraBrew Launcher"
            Name="LocalData"
            Type="string"
            Value="[LOCALDATA]" />

      </Component>

      <Component Id="UriSchemeUser" Guid="7D2E9B41-6C58-4F0A-B3D7-58E1A2C64F93">
        <RegistryKey Root="HKCU" Key="Software\Classes\launcher-astrabrew">
          <RegistryValue Type="string" Value="URL:AstraBrew Launcher Protocol" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]AstraBrew Launcher.exe&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]AstraBrew Launcher.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
