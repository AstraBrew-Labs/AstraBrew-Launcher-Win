<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AstraBrew_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AstraBrew_Launcher"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:views="using:AstraBrew_Launcher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AstraBrew Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自定义标题栏：品牌标识 + 哑文字层，右侧留给系统窗口按钮  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,160,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <!--  品牌标记：随主题在深色/浅色两版之间切换  -->
                <Image
                    x:Name="TitleBarBrand"
                    Height="17"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="星酿启动器"
                    Source="{ThemeResource BrandIconSource}"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="AstraBrew Launcher" />

                <!--
                    渠道标记：预览版 / 测试版 / 开发版，正式版整个收起（不留空位）。
                    放在标题栏而不是只放关于页——非正式版最容易出问题，
                    用户截一张图、报一句 bug，看左上角就知道是哪个渠道的构建。
                -->
                <Border
                    x:Name="ChannelBadge"
                    Padding="8,2,8,3"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ChannelBadgeText"
                        FontSize="11.5"
                        FontWeight="SemiBold" />
                </Border>

                <Rectangle
                    Width="1"
                    Height="12"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="酒馆启动器" />

                <!--  全局状态：当前酒馆实例的来源与版本（内置-1.19.2 / 本地-1.19.0），任何页面都可见  -->
                <Rectangle
                    Width="1"
                    Height="12"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Border
                    x:Name="InstanceChip"
                    Padding="8,2,8,3"
                    VerticalAlignment="Center"
                    Background="{ThemeResource InstanceChipBackgroundBrush}"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="InstanceChipText"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InstanceChipForegroundBrush}"
                        Text="内置-1.19.2" />
                </Border>
            </StackPanel>
        </Grid>

        <!--
            内容区：外面这层只负责给出可用区域，里面那层才是被缩放的实体。
            界面缩放 = 内层按「容器尺寸 ÷ 缩放」排版 + ScaleTransform 乘回去，
            标题栏留在缩放之外，否则它会和系统绘制的窗口按钮错位。
        -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <Grid
                x:Name="ContentRoot"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

                <!--  主体导航  -->
                <NavigationView
                    x:Name="NavView"
                    CompactModeThresholdWidth="760"
                    CompactPaneLength="48"
                    ExpandedModeThresholdWidth="1020"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="220"
                    PaneDisplayMode="Left"
                    SelectionChanged="NavView_SelectionChanged">

                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="仪表盘" Tag="dashboard">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="酒馆配置" Tag="tavern">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9F5;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="版本管理" Tag="versions">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE81C;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="扩展管理" Tag="extensions">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE74C;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.InfoBadge>
                                <!--  待更新数量由扩展页检查更新后写入，默认不显示（没有数据时挂个 0 只会误导）  -->
                                <InfoBadge
                                    x:Name="ExtensionsBadge"
                                    Value="0"
                                    Visibility="Collapsed" />
                            </NavigationViewItem.InfoBadge>
                        </NavigationViewItem>
                        <NavigationViewItem Content="资源管理" Tag="resources">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>

                    <NavigationView.FooterMenuItems>
                        <NavigationViewItem Content="控制台" Tag="console">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE756;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="设置" Tag="settings">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="关于" Tag="about">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.FooterMenuItems>

                    <Frame x:Name="ContentFrame" />
                </NavigationView>

                <!--  首次启动引导：覆盖内容区（含导航栏），标题栏保持可用  -->
                <views:OnboardingView
                    x:Name="Onboarding"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!--
            全局消息栈：贴内容区右下角，任何页面的结果都在这里播报（成功会自己消失，失败留到用户关掉）。
            刻意挂在 ContentHost 外面——这里只有窗口级的 Row，不参与 ContentRoot 的界面缩放，
            消息卡跟弹窗一样按 100% 呈现，不会随缩放跑到窗口边缘外。
        -->
        <controls:NotifyHost
            x:Name="Notifications"
            Grid.Row="1"
            Margin="0,0,18,18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />
    </Grid>
</Window>
