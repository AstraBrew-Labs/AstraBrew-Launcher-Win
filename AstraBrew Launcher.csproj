<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AstraBrew_Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <!--
      四个发布渠道各占一个构建配置，渠道标记编进程序集（见 Services/BuildChannelInfo.cs）：
        Alpha   预览版 —— 新功能先上这条线，随时可能坏
        Beta    测试版 —— 功能定稿、找 bug 的阶段
        Debug   开发版 —— 本机开发用，带调试符号、不做裁剪
        Release 正式版 —— 对外发布，关于页不显示任何渠道标记
    -->
    <Configurations>Debug;Release;Alpha;Beta</Configurations>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!--  exe / 任务栏 / 窗口图标统一使用 Assets 里的彩色版本  -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!--
      版本号只有一个源头：这里。AssemblyVersion / FileVersion / InformationalVersion 全部由它派生，
      关于页与设置页都读程序集版本，不要在任何页面里再写死一个「v0.3.0」。
      0.3 是第一条对外可用的基线：0.1 / 0.2 阶段都还没走到「能装完酒馆并跑起来」。
    -->
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\app.ico" />
    <Content Include="Assets\brand-icon-light.png" />
    <Content Include="Assets\brand-icon-dark.png" />
    <Content Include="Assets\brand-lockup-light.png" />
    <Content Include="Assets\brand-lockup-dark.png" />
  </ItemGroup>

  <!--
    内置字体：随包分发，设置页里「软件默认」用的就是这一份，不依赖本机是否安装。
    文件名用 PostScript 名（Nowar-Warcraft-Rounded-CN-*）而不是中文名：
    ms-appx:/// 是 URI，中文路径要转义，换成中文名后出问题很难查。
    族名仍以 ttf 里的 name 表为准（有愛魔獸圓體 CN），见 FontCatalog.EmbeddedFamily。
  -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!--
    非打包构建时 Content 不会自动落到输出目录，ms-appx:///Assets/... 会解析失败
    （表现是 Image 渲染成一片空白）。这里统一补上复制到输出目录。
  -->
  <ItemGroup>
    <Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    渠道标记：用 AssemblyMetadata 而不是 #if 常量。
    DefineConstants 在 SDK 里由 targets 追加，项目体里读到的往往是空值，
    拼进去的常量可能被后面的 DEBUG;TRACE 覆盖掉——踩过一次就很难查。
    AssemblyMetadata 由 SDK 生成到 AssemblyInfo，运行时读得到，且不写就等于「正式版」。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildChannel" Value="Alpha" Condition="'$(Configuration)' == 'Alpha'" />
    <AssemblyMetadata Include="BuildChannel" Value="Beta" Condition="'$(Configuration)' == 'Beta'" />
    <AssemblyMetadata Include="BuildChannel" Value="Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!--  设备访问弹窗里的二维码：只用它的矩阵（QRCodeData），画到 XAML 里，不碰 System.Drawing  -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!--
    调试构建一律把 Windows App SDK 运行库复制到输出目录（自包含）。
    本机只装了 framework-only 的 WindowsAppRuntime.2（缺 Deployment/CBS 组件），
    走框架依赖模式时 WindowsAppSDK 的启动自举会抛 REGDB_E_CLASSNOTREG 直接崩，
    exe 表现为「进程在、无窗口」或双击无反应。自包含后不再依赖系统运行时，
    且 VS 里的 (Unpackaged) 调试与直接双击 exe 都能跑。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Alpha' Or '$(Configuration)' == 'Beta'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>