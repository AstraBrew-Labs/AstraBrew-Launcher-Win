<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AstraBrew_Launcher.Views.Onboarding.OnboardingStep4Instance"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <!--  二选一：装过 / 没装过  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton
                x:Name="OptionLocal"
                MinHeight="72"
                GroupName="InstanceMode"
                Style="{StaticResource OptionCardStyle}"
                Checked="Mode_Checked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8E5;" />
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Text="我已经有酒馆了" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="自动找一找，或自己选文件夹" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <RadioButton
                x:Name="OptionBuiltin"
                Grid.Column="1"
                MinHeight="72"
                GroupName="InstanceMode"
                Style="{StaticResource OptionCardStyle}"
                Checked="Mode_Checked">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE896;" />
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Text="我还没有" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="让启动器下载一份" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!--  ==================== 本地实例 ====================  -->
        <StackPanel
            x:Name="LocalPanel"
            Spacing="10"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanButton" Click="Scan_Click" Content="自动找一找" />
                <Button x:Name="AddButton" Click="Add_Click" Content="自己选…" />
                <TextBlock
                    x:Name="ScanStatusText"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="会翻遍所有硬盘，慢的话要等几分钟。" />
            </StackPanel>

            <Border
                x:Name="LocalListCard"
                MaxHeight="176"
                Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LocalListHost" Spacing="1" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!--  ==================== 内置实例 ====================  -->
        <StackPanel
            x:Name="BuiltinPanel"
            Spacing="10"
            Visibility="Collapsed">
            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="BuiltinTitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="启动器自带的酒馆" />
                    <TextBlock
                        x:Name="BuiltinInfoText"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="正在查版本…" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="BuiltinProgressPanel" Spacing="6" Visibility="Collapsed">
                <ProgressBar x:Name="BuiltinBar" Height="4" Maximum="100" />
                <TextBlock
                    x:Name="BuiltinProgressText"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="InstallBuiltinButton"
                    Click="InstallBuiltin_Click"
                    Style="{StaticResource AccentActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                        <TextBlock Text="下载并启用" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="InstallDepsButton"
                    Click="InstallDeps_Click"
                    Content="补装零件"
                    Visibility="Collapsed" />

                <Button
                    x:Name="BackToRuntimeButton"
                    Click="BackToRuntime_Click"
                    Content="回去装工具"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            x:Name="StateText"
            FontSize="11.5"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="先选一种：用你有的，还是让启动器装。" />
    </StackPanel>
</UserControl>
