<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AstraBrew_Launcher.Views.Onboarding.OnboardingStep2Network"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <!--  四项连通性  -->
        <StackPanel Spacing="2">
            <controls:CheckRow
                x:Name="RowPing"
                DetailKey="Setup.S2.Row.Ping.Detail"
                Glyph="&#xE701;"
                TitleKey="Setup.S2.Row.Ping.Title" />
            <controls:CheckRow
                x:Name="RowDns"
                DetailKey="Setup.S2.Row.Dns.Detail"
                Glyph="&#xE774;"
                TitleKey="Setup.S2.Row.Dns.Title" />
            <controls:CheckRow
                x:Name="RowApi"
                DetailKey="Setup.S2.Row.Api.Detail"
                Glyph="&#xE8B7;"
                TitleKey="Setup.S2.Row.Api.Title" />
            <controls:CheckRow
                x:Name="RowRaw"
                DetailKey="Setup.S2.Row.Raw.Detail"
                Glyph="&#xE8A5;"
                TitleKey="Setup.S2.Row.Raw.Title" />
        </StackPanel>

        <!--  API 被限流的专属提示  -->
        <Border
            x:Name="RateLimitCard"
            Padding="12"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        x:Name="RateLimitText"
                        Grid.Column="1"
                        FontSize="12.5"
                        TextWrapping="Wrap" />
                </Grid>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="FixRouteButton"
                        Click="FixRoute_Click"
                        Style="{StaticResource AccentActionButtonStyle}"
                        controls:Loc.Content="Setup.S2.Fix.EnableAccel" />
                    <Button x:Name="SkipGithubButton" Click="SkipGithub_Click" controls:Loc.Content="Setup.S2.Skip" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  镜像测速  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    controls:Loc.Text="Setup.S2.Mirror.Title" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    controls:Loc.Text="Setup.S2.Mirror.Hint" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="MirrorHost" Spacing="2" />

        <TextBlock
            x:Name="SummaryText"
            FontSize="11.5"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
