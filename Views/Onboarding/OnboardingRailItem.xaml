<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AstraBrew_Launcher.Views.Onboarding.OnboardingRailItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        时间轴的一节：圆点 24 + 标题 + 副标，长度固定 71（下一节从 71 开始）。
        连线画在同一格里、从圆点底部（24）一直连到 71——正好接到下一节的圆点顶，
        这样四节叠起来是一条不断的线，不用在外壳里算偏移。
    -->
    <Grid Height="71">
        <!--
            连线：显式给定 2×47 的槽 + 自己的坐标（0..47），不要靠 Stretch 让 Shape 自己量。
            Shape 的 MeasureOverride 只按几何包围盒算，竖线的包围盒宽度是 0，
            Stretch 之后就画不出来（踩过）。X=1 让 2 宽的描边正好落在槽中间。
        -->
        <Line
            x:Name="Connector"
            Width="2"
            Height="47"
            Margin="11,24,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
            StrokeThickness="2"
            X1="1"
            X2="1"
            Y1="0"
            Y2="47" />

        <!--  序号 / 勾选 / 跳过：四种状态叠在同一格里，靠显隐切换  -->
        <Grid
            Width="24"
            Height="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Border
                x:Name="IdleDot"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="12">
                <TextBlock
                    x:Name="NumberText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <Border
                x:Name="ActiveDot"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ActiveNumberText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>

            <Border
                x:Name="DoneDot"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                CornerRadius="12"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="10"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
            </Border>

            <!--  跳过：空心圈 + 一道短横，跟「已完成」的勾明确区分开  -->
            <Border
                x:Name="SkippedDot"
                Background="Transparent"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <Rectangle
                    Width="8"
                    Height="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource TextFillColorTertiaryBrush}"
                    RadiusX="1"
                    RadiusY="1" />
            </Border>
        </Grid>

        <StackPanel
            Margin="36,0,0,0"
            Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource OnboardingRailTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource OnboardingRailSubtitleTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
