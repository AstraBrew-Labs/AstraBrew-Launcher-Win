<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.VersionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AstraBrew_Launcher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1020" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  内置卡：版本信息与切换面板由并排改为上下  -->
                        <Setter Target="SwitchCol.Width" Value="0" />
                        <Setter Target="SwitchPanelRoot.(Grid.Row)" Value="1" />
                        <Setter Target="SwitchPanelRoot.(Grid.Column)" Value="0" />
                        <Setter Target="SwitchPanelRoot.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SwitchPanelRoot.Margin" Value="0,16,0,0" />

                        <!--  页头：状态胶囊下移到标题下方  -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="2" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Style="{StaticResource PageRootStyle}">

            <!--  ==================== 页头 ====================  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="版本管理" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="内置实例锁定一份代码，本地实例可以并存多个；在这里切换、检查依赖与清理目录。" />
                </StackPanel>

                <StackPanel
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">
                    <Border Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock
                                x:Name="HeaderCurrentText"
                                Style="{StaticResource StatusPillTextStyle}"
                                Text="当前 · 内置 v1.19.2" />
                        </StackPanel>
                    </Border>
                    <Button
                        AutomationProperties.Name="刷新实例状态"
                        Click="Refresh_Click"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="刷新实例状态">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                ==================== Tab 切换 ====================
                两个页面各自完整，Tab 只负责切换，不承载状态。
            -->
            <Border
                Padding="4,4,4,0"
                Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton
                        x:Name="LocalTab"
                        AutomationProperties.Name="本地实例"
                        Checked="TabStrip_Checked"
                        GroupName="VersionTabs"
                        IsChecked="True"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Text="本地实例" />
                            <Border
                                Padding="6,0,6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    x:Name="LocalTabCount"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="3" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        x:Name="BuiltinTab"
                        AutomationProperties.Name="内置实例"
                        Checked="TabStrip_Checked"
                        GroupName="VersionTabs"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="14" Glyph="&#xE7B8;" />
                            <TextBlock Text="内置实例" />
                            <Border
                                Padding="6,0,6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="单实例" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!--
                ==================== 本地实例 ====================
                用户已有的酒馆目录，可并存多个；每行独立表达依赖状态与可执行动作。
            -->
            <StackPanel x:Name="LocalPanel" Spacing="16">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>

                        <!--  卡头  -->
                        <Grid Padding="18,14,18,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                Background="#1F2B88D8"
                                CornerRadius="8">
                                <FontIcon
                                    FontSize="17"
                                    Foreground="#FF2B88D8"
                                    Glyph="&#xE8B7;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="已扫描到的本地酒馆" />
                                <TextBlock x:Name="LocalSummaryText" Style="{StaticResource FieldHintTextStyle}" Text="已发现 3 个实例 · 1 个缺少依赖" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button Click="Scan_Click" ToolTipService.ToolTip="扫描本地磁盘中的酒馆目录">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="13" Glyph="&#xE721;" />
                                        <TextBlock Text="扫描" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Import_Click" ToolTipService.ToolTip="指定一个已存在的酒馆 package.json">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                                        <TextBlock Text="导入" />
                                    </StackPanel>
                                </Button>
                                <!--
                                    逐盘进度与命中清单的入口。搬到这里是因为「扫描到哪了」这句
                                    已经由右下角的常驻消息一直说着，列表顶部不必再占一条。
                                -->
                                <Button
                                    x:Name="ScanDetailBtn"
                                    AutomationProperties.Name="扫描详情"
                                    Click="ScanDetail_Click"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTipService.ToolTip="扫描详情：逐盘进度与找到的实例"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="13" Glyph="&#xE9D9;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  实例列表：8 的卡片内缩 + 10 的行内边距 = 与卡头、卡底同为 18 的内容线  -->
                        <ItemsControl
                            x:Name="LocalList"
                            Margin="8,10,8,12"
                            ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:LocalInstanceRow">
                                    <Border Padding="10,10" Style="{StaticResource SubPanelStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  与卡头图标座同宽（38），让标题列与版本号列落在同一条竖直线上  -->
                                            <Border
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Center"
                                                Background="#1F2B88D8"
                                                CornerRadius="8">
                                                <FontIcon
                                                    FontSize="17"
                                                    Foreground="#FF2B88D8"
                                                    Glyph="&#xE7B8;" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">

                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Text="{x:Bind VersionLabel}" />

                                                    <Border
                                                        Padding="8,0,8,1"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="9"
                                                        Visibility="{x:Bind CurrentVisibility}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="使用中" />
                                                    </Border>

                                                    <Border
                                                        Style="{StaticResource StatePillStyle}"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        Visibility="{x:Bind ReadyVisibility}">
                                                        <TextBlock
                                                            Style="{StaticResource StatePillTextStyle}"
                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                            Text="依赖就绪" />
                                                    </Border>

                                                    <Border
                                                        Style="{StaticResource StatePillStyle}"
                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        Visibility="{x:Bind MissingVisibility}">
                                                        <TextBlock
                                                            Style="{StaticResource StatePillTextStyle}"
                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                            Text="缺少依赖" />
                                                    </Border>

                                                    <Border Style="{StaticResource MetaChipStyle}">
                                                        <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="{x:Bind NodeText}" />
                                                    </Border>
                                                </StackPanel>

                                                <!--  路径与版本号共用同一条左线：不在行内再塞小图标  -->
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Path}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--  行内动作：与卡头按钮组同一条 8 的间隔，文字按钮右边缘才能对齐  -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">

                                                <Button
                                                    Click="LocalFixDeps_Click"
                                                    Content="{x:Bind FixText}"
                                                    IsEnabled="{x:Bind FixEnabled}"
                                                    Style="{StaticResource AccentActionButtonStyle}"
                                                    Visibility="{x:Bind FixVisibility}" />

                                                <Button
                                                    Click="LocalUse_Click"
                                                    IsEnabled="{x:Bind UseEnabled}"
                                                    Visibility="{x:Bind UseVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE7E8;" />
                                                        <TextBlock Text="{x:Bind UseText}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button
                                                    AutomationProperties.Name="移除实例"
                                                    Click="LocalRemove_Click"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="从列表移除（不删除目录）">
                                                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  空状态  -->
                        <StackPanel
                            x:Name="LocalEmpty"
                            Padding="24,40"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="30"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8B7;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CardTitleTextStyle}"
                                Text="还没有本地实例" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource FieldHintTextStyle}"
                                Text="扫描磁盘，或指定一个已存在酒馆的 package.json。" />
                            <StackPanel
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="Scan_Click" Content="开始扫描" Style="{StaticResource AccentActionButtonStyle}" />
                                <Button Click="Import_Click" Content="手动添加" />
                            </StackPanel>
                        </StackPanel>

                        <!--  卡底说明  -->
                        <Border
                            Padding="18,10,18,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="切换只改变启动器使用哪一份代码，不会复制或删除目录；缺少依赖的实例需要先安装 Node 依赖才能启动。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                ==================== 内置实例 ====================
                不是列表：一份代码、一个实例，因此用一张卡承载全部状态与操作。
            -->
            <StackPanel
                x:Name="BuiltinPanel"
                Spacing="16"
                Visibility="Collapsed">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>

                        <!--  卡头：身份 + 约束声明  -->
                        <Grid Padding="18,16,18,14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="44"
                                Height="44"
                                VerticalAlignment="Center"
                                Background="#1F2B88D8"
                                CornerRadius="10">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="#FF2B88D8"
                                    Glyph="&#xE7B8;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="内置酒馆" />
                                    <Border
                                        Padding="8,1,8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="9">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="单实例" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="由启动器托管的唯一一份代码，只运行一个实例，不支持多开与版本共存。" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                                <!--  使用中：当前来源就是内置实例  -->
                                <Border
                                    x:Name="BuiltinActivePill"
                                    Style="{StaticResource StatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="使用中" />
                                    </StackPanel>
                                </Border>

                                <!--  已安装：内置实例存在，但当前在用某个本地实例  -->
                                <Border x:Name="BuiltinIdlePill" Style="{StaticResource StatusPillStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="已安装" />
                                    </StackPanel>
                                </Border>

                                <!--  未安装：磁盘上没有代码，只有一个空目录名可填  -->
                                <Border x:Name="BuiltinMissingPill" Style="{StaticResource StatusPillStyle}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="未安装" />
                                    </StackPanel>
                                </Border>

                                <!--  有代码、缺依赖：这份代码起不来，先补 node_modules  -->
                                <Border x:Name="BuiltinDepsPill" Style="{StaticResource StatusPillStyle}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="待装依赖" />
                                    </StackPanel>
                                </Border>

                                <!--
                                    从本地实例切回内置实例的唯一入口。
                                    仅在当前使用本地实例时出现，与本地实例行内的「使用」按钮对称。
                                -->
                                <Button
                                    x:Name="UseBuiltinBtn"
                                    Click="UseBuiltin_Click"
                                    Style="{StaticResource AccentActionButtonStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="13" Glyph="&#xE7E8;" />
                                        <TextBlock Text="使用内置实例" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  当前版本 + 切换面板  -->
                        <Grid
                            Padding="18,0,18,16"
                            ColumnSpacing="20"
                            RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SwitchCol" Width="336" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="当前版本" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="BuiltinVersionText"
                                        FontSize="30"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="v1.19.2" />
                                    <Border
                                        x:Name="LatestPill"
                                        Padding="8,1,8,3"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="9">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="最新" />
                                    </Border>
                                </StackPanel>

                                <StackPanel
                                    x:Name="MetaRow"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock x:Name="MetaChannelText" Style="{StaticResource MetaChipTextStyle}" Text="稳定版" />
                                    </Border>
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock x:Name="MetaDateText" Style="{StaticResource MetaChipTextStyle}" Text="发布于 2026-09-14" />
                                    </Border>
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock x:Name="MetaTagText" Style="{StaticResource MetaChipTextStyle}" Text="标签 1.19.0" />
                                    </Border>
                                </StackPanel>

                                <Border Padding="10,8" Style="{StaticResource SubPanelStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE8B7;" />
                                        <TextBlock
                                            x:Name="BuiltinPathText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="C:\Users\al01\AppData\Roaming\AstraBrew Launcher\sillytavern"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="复制安装路径"
                                            Click="CopyBuiltinPath_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="复制安装路径">
                                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  单实例模型的由来：就地把「为什么不能多开」讲清楚；不带前置图标，正文与上方胶囊同一条左线  -->
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="内置实例使用固定的数据目录与端口，因此只保留一份代码；需要并行测试多个版本时，请把目录放进「本地实例」管理。" />
                            </StackPanel>

                            <!--  切换版本：唯一入口，明确「覆盖」语义  -->
                            <Border
                                x:Name="SwitchPanelRoot"
                                Grid.Column="1"
                                Padding="14,12"
                                Style="{StaticResource SubPanelStyle}">
                                <StackPanel Spacing="9">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="切换版本" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MetaChipTextStyle}"
                                            Text="覆盖安装" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <RadioButton
                                            x:Name="StableChip"
                                            AutomationProperties.Name="稳定版通道"
                                            Checked="Channel_Checked"
                                            Content="稳定版"
                                            GroupName="Channel"
                                            IsChecked="True"
                                            Style="{StaticResource ChoiceChipRadioStyle}" />
                                        <RadioButton
                                            x:Name="StagingChip"
                                            AutomationProperties.Name="开发版通道"
                                            Checked="Channel_Checked"
                                            Content="开发版"
                                            GroupName="Channel"
                                            Style="{StaticResource ChoiceChipRadioStyle}" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="VersionPicker"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="选择版本"
                                        SelectionChanged="VersionPicker_SelectionChanged" />

                                    <!--
                                        装之前先说清楚「这份代码从哪来」：
                                        镜像里有这个版本就走镜像，没有就直接从 GitHub 拉。
                                    -->
                                    <Border x:Name="SourceRouteRow" Padding="10,7" Style="{StaticResource SubPanelStyle}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border
                                                    x:Name="MirrorOkChip"
                                                    Padding="7,1,7,2"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="9"
                                                    Visibility="Collapsed">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Text="镜像可用" />
                                                </Border>
                                                <Border
                                                    x:Name="DirectChip"
                                                    Padding="7,1,7,2"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="9"
                                                    Visibility="Collapsed">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="直连安装" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="SourceRouteText"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="正在比对镜像版本…"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        x:Name="ReleaseCacheText"
                                        Style="{StaticResource FieldHintTextStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="正在读取版本列表…" />

                                    <Button
                                        x:Name="SwitchVersionBtn"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="SwitchVersion_Click"
                                        Content="已是当前版本"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentActionButtonStyle}" />

                                    <TextBlock
                                        x:Name="SwitchHintText"
                                        Style="{StaticResource FieldHintTextStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="切换会覆盖当前版本，旧版本不会保留。" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  开发版风险提示  -->
                        <InfoBar
                            x:Name="StagingNote"
                            Margin="18,0,18,14"
                            IsClosable="False"
                            IsOpen="False"
                            Message="直接跟随 staging 分支构建，包含未发布改动，可能随时出现异常；可随时切回稳定版。"
                            Severity="Warning"
                            Title="开发版可能不稳定" />

                        <!--  切换进度：与卡片同居一处，不用弹窗打断  -->
                        <Border x:Name="SwitchProgressPanel" Visibility="Collapsed">
                            <StackPanel Padding="18,0,18,16" Spacing="10">
                                <Rectangle
                                    Height="1"
                                    Margin="0,0,0,4"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid>
                                    <TextBlock
                                        x:Name="SwitchPhaseText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="第 1/2 步 · 正在下载源码" />
                                    <TextBlock
                                        x:Name="SwitchPercentText"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MetaChipTextStyle}"
                                        Text="0%" />
                                </Grid>

                                <ProgressBar
                                    x:Name="SwitchBar"
                                    Height="4"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="0" />

                                <Expander x:Name="SwitchLogExpander" HorizontalAlignment="Stretch" Header="查看日志">
                                    <ScrollViewer
                                        x:Name="SwitchLogScroll"
                                        MaxHeight="120"
                                        VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="SwitchLog"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!--  卡底操作：右侧按钮与卡头、卡底内容同一条 18 的内容线  -->
                        <Border
                            Padding="18,8,18,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="切换会重建代码目录，建议先在仪表盘停止正在运行的服务。" />

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="RefreshReleasesBtn"
                                        Click="RefreshReleases_Click"
                                        ToolTipService.ToolTip="忽略缓存，重新从 GitHub 获取版本列表">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                            <TextBlock x:Name="RefreshReleasesText" Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                    <HyperlinkButton
                                        Padding="12,4"
                                        Click="ViewChangelog_Click"
                                        Content="更新日志" />
                                    <Button Click="CheckUpdate_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="13" Glyph="&#xE895;" />
                                            <TextBlock Text="检查更新" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenBuiltinDir_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                                            <TextBlock Text="打开安装目录" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
