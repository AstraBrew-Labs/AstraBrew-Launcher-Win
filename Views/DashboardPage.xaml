<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="仪表盘" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="酒馆服务状态、运行指标与常用操作入口。" />
            </StackPanel>

            <!--  服务状态  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleTextStyle}"
                                Text="运行中" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardBodyTextStyle}"
                                Text="SiliconTavern v1.4.2" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="监听 127.0.0.1:8000　·　已运行 2 小时 14 分" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                            <Button Content="重启服务" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="停止" />
                            <Button Content="打开控制台" Click="OpenConsole_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="进程 ID" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MonoTextStyle}"
                                Text="14208" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="内存占用" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MonoTextStyle}"
                                Text="312 MB" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="CPU" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MonoTextStyle}"
                                Text="3.4%" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  指标  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="当前版本" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="v1.4.2" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="stable 通道" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="已装扩展" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="12" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="3 个待更新" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="角色卡" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="48" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="共 26.4 MB" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="磁盘占用" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="1.8 GB" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="安装目录 1.3 GB" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  最近活动 + 快捷操作  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="最近活动" />
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="· 更新扩展「长期记忆」到 v2.1.0" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="· 切换到版本 v1.4.2（stable）" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="· 导入角色卡 6 张" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="· 修改服务端口 8100 → 8000" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="快捷操作" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="启动酒馆"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="检查版本更新" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="打开数据目录" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
