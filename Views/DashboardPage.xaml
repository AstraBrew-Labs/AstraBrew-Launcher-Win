<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1020" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetricsGrid.RowSpacing" Value="0" />
                        <Setter Target="QuickGrid.RowSpacing" Value="0" />
                        <Setter Target="HeroContent.RowSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  指标：4 列 → 2×2  -->
                        <Setter Target="MetricCol2.Width" Value="0" />
                        <Setter Target="MetricCol3.Width" Value="0" />
                        <Setter Target="Tile3.(Grid.Row)" Value="1" />
                        <Setter Target="Tile3.(Grid.Column)" Value="0" />
                        <Setter Target="Tile4.(Grid.Row)" Value="1" />
                        <Setter Target="Tile4.(Grid.Column)" Value="1" />
                        <Setter Target="MetricsGrid.RowSpacing" Value="12" />

                        <!--  启动配置：双栏 → 单栏，模式设置下移  -->
                        <Setter Target="SettingsCol.Width" Value="0" />
                        <Setter Target="ModeSettingsPanel.(Grid.Row)" Value="2" />
                        <Setter Target="ModeSettingsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ModeSettingsPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ModeSettingsPanel.Margin" Value="0,14,0,0" />

                        <!--  快捷操作：3 列 → 2×3  -->
                        <Setter Target="QaCol2.Width" Value="0" />
                        <Setter Target="Qa3.(Grid.Row)" Value="1" />
                        <Setter Target="Qa3.(Grid.Column)" Value="0" />
                        <Setter Target="Qa4.(Grid.Row)" Value="1" />
                        <Setter Target="Qa4.(Grid.Column)" Value="1" />
                        <Setter Target="Qa5.(Grid.Row)" Value="2" />
                        <Setter Target="Qa5.(Grid.Column)" Value="0" />
                        <Setter Target="Qa6.(Grid.Row)" Value="2" />
                        <Setter Target="Qa6.(Grid.Column)" Value="1" />
                        <Setter Target="QuickGrid.RowSpacing" Value="10" />

                        <!--  Hero 右侧运行时长下移，收成一行  -->
                        <Setter Target="HeroUptime.(Grid.Row)" Value="1" />
                        <Setter Target="HeroUptime.(Grid.Column)" Value="0" />
                        <Setter Target="HeroUptime.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeroUptime.Margin" Value="0,16,0,0" />
                        <Setter Target="HeroUptime.Orientation" Value="Horizontal" />
                        <Setter Target="HeroUptime.Spacing" Value="10" />
                        <Setter Target="HeroUptimePanel.Orientation" Value="Horizontal" />
                        <Setter Target="HeroUptimePanel.Spacing" Value="10" />
                        <Setter Target="HeroUptimeLabel.VerticalAlignment" Value="Bottom" />
                        <Setter Target="HeroUptimeLabel.Margin" Value="0,0,0,5" />
                        <Setter Target="HeroUptimePid.VerticalAlignment" Value="Bottom" />
                        <Setter Target="HeroUptimePid.Margin" Value="0,0,0,8" />
                        <Setter Target="HeroTopGrid.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Style="{StaticResource PageRootStyle}">

            <!--  ==================== 页头 ====================  -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="仪表盘" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="服务状态、启动配置与常用操作" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="LastSyncText"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetricLabelTextStyle}"
                            Text="本地进程 · 2 秒采样" />
                        <Button
                            Click="Refresh_Click"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            AutomationProperties.Name="刷新指标"
                            ToolTipService.ToolTip="刷新指标">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  操作反馈：收起时不占位，避免布局跳动  -->
                <InfoBar
                    x:Name="ActionInfoBar"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
            </Grid>

            <!--  ==================== 服务主卡 ====================  -->
            <Border x:Name="HeroCard" Style="{StaticResource HeroCardStyle}">
                <Grid>
                    <!--  卡片底色  -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" />

                    <!--  品牌光晕：以左上角为光源的柔和径向光，暗色主题下不会糊成脏块  -->
                    <Border CornerRadius="8" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush
                                Center="0.12,0"
                                GradientOrigin="0.12,0"
                                MappingMode="RelativeToBoundingBox"
                                RadiusX="0.85"
                                RadiusY="0.95">
                                <GradientStop Color="#2EF0B23E" Offset="0" />
                                <GradientStop Color="#12F0B23E" Offset="0.55" />
                                <GradientStop Color="#00F0B23E" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid
                        x:Name="HeroContent"
                        Padding="24,20,24,18"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeroTopGrid" ColumnSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="12">
                                <!--  状态行  -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <Grid
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center">
                                        <Ellipse
                                            x:Name="StatusHalo"
                                            Width="14"
                                            Height="14"
                                            Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                            Opacity="0.28" />
                                        <Ellipse
                                            x:Name="StatusDotRunning"
                                            Width="8"
                                            Height="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <Ellipse
                                            x:Name="StatusDotStopped"
                                            Width="8"
                                            Height="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ServiceStateText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitleTextStyle}"
                                        Text="服务运行中" />
                                    <Border Style="{StaticResource StatusPillStyle}">
                                        <TextBlock
                                            x:Name="HeroVersionPillText"
                                            Style="{StaticResource StatusPillTextStyle}"
                                            Text="内置 · v1.19.2" />
                                    </Border>
                                </StackPanel>

                                <!--  端点  -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE774;" />
                                    <TextBlock
                                        x:Name="EndpointText"
                                        Style="{StaticResource MonoTextStyle}"
                                        Text="http://127.0.0.1:8000" />
                                    <Button
                                        Click="CopyEndpoint_Click"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        AutomationProperties.Name="复制服务地址"
                                        ToolTipService.ToolTip="复制地址">
                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                    </Button>
                                    <TextBlock
                                        x:Name="CopyFeedback"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Opacity="0"
                                        Text="已复制" />
                                </StackPanel>

                                <!--  主操作  -->
                                <StackPanel
                                    Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button Click="Restart_Click" Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                            <TextBlock Text="重启服务" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Stop_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                            <TextBlock Text="停止" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!--  运行时长  -->
                            <StackPanel
                                x:Name="HeroUptime"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="0">
                                <TextBlock
                                    x:Name="HeroUptimeLabel"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource MetricLabelTextStyle}"
                                    Text="已持续运行" />
                                <StackPanel
                                    x:Name="HeroUptimePanel"
                                    Orientation="Vertical"
                                    Spacing="0">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="02:14:37" />
                                    <TextBlock
                                        x:Name="HeroUptimePid"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MetricLabelTextStyle}"
                                        Text="PID 14208" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Margin="0,18,0,0"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--  指标条  -->
                        <Grid
                            Grid.Row="2"
                            Margin="0,14,0,0"
                            ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="1">
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="内存占用" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="312 MB" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="CPU" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="3.4%" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="今日请求" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="1,284" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="1">
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="平均响应" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="0.86 s" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!--  ==================== 指标卡 ====================  -->
            <Grid
                x:Name="MetricsGrid"
                ColumnSpacing="12"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MetricCol2" Width="*" />
                    <ColumnDefinition x:Name="MetricCol3" Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MetricLabelTextStyle}"
                                Text="当前版本" />
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE81C;" />
                        </Grid>
                        <TextBlock
                            x:Name="CurrentVersionValue"
                            Style="{StaticResource MetricValueTextStyle}"
                            Text="v1.19.2" />
                        <TextBlock
                            x:Name="CurrentVersionCaption"
                            Style="{StaticResource FootnoteTextStyle}"
                            Text="内置酒馆 · 已是最新" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MetricLabelTextStyle}"
                                Text="已装扩展" />
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE74C;" />
                        </Grid>
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="12" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="5"
                                Height="5"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="3 个待更新" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="Tile3"
                    Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MetricLabelTextStyle}"
                                Text="角色卡" />
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE77B;" />
                        </Grid>
                        <TextBlock Style="{StaticResource MetricValueTextStyle}">
                            <Run Text="48" />
                            <Run
                                FontSize="13"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text=" 张" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="共 26.4 MB" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="Tile4"
                    Grid.Column="3"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MetricLabelTextStyle}"
                                Text="磁盘占用" />
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xEDA2;" />
                        </Grid>
                        <TextBlock Style="{StaticResource MetricValueTextStyle}">
                            <Run Text="1.8" />
                            <Run
                                FontSize="13"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text=" GB" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="安装目录 1.3 GB" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 启动配置 ====================  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SettingsCol" Width="330" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="启动配置" />
                        <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="选择酒馆版本与运行模式，保存后下次启动生效" />
                    </StackPanel>

                    <!--  左列：版本 + 启动模式  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Spacing="16">

                        <!--  酒馆版本  -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="酒馆版本" />
                                <HyperlinkButton
                                    Padding="4,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="管理版本"
                                    Click="ManageVersions_Click"
                                    Content="管理版本" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    x:Name="VersionCombo"
                                    MinWidth="220"
                                    AutomationProperties.Name="酒馆版本"
                                    SelectionChanged="VersionCombo_SelectionChanged">
                                    <ComboBoxItem Content="内置酒馆" />
                                    <ComboBoxItem Content="本地-1.19.0" />
                                    <ComboBoxItem Content="本地-1.18.0" />
                                    <ComboBoxItem Content="本地-1.17.2" />
                                </ComboBox>
                                <Button
                                    Click="RescanVersions_Click"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    AutomationProperties.Name="重新扫描本地版本"
                                    ToolTipService.ToolTip="重新扫描本地版本">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>

                            <Border Padding="12,9,12,10" Style="{StaticResource SubPanelStyle}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border x:Name="VersionTypeTag" Style="{StaticResource StatusPillStyle}">
                                                <TextBlock
                                                    x:Name="VersionTypeText"
                                                    Style="{StaticResource StatusPillTextStyle}"
                                                    Text="内置" />
                                            </Border>
                                            <TextBlock
                                                x:Name="VersionKernelText"
                                                Style="{StaticResource CellTextStyle}"
                                                Text="内核 v1.19.2" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="VersionSizeText"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FootnoteTextStyle}"
                                            Text="428 MB" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="VersionPathText"
                                        Style="{StaticResource MonoTextStyle}"
                                        Text="…\lib\tavern"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  启动模式  -->
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="启动模式" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton
                                    x:Name="NormalModeRadio"
                                    AutomationProperties.Name="普通模式"
                                    Checked="Mode_Checked"
                                    GroupName="LaunchMode"
                                    IsChecked="True"
                                    Style="{StaticResource ChoiceCardRadioStyle}">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="普通模式" />
                                </RadioButton>

                                <RadioButton
                                    x:Name="DesktopModeRadio"
                                    Grid.Column="1"
                                    AutomationProperties.Name="桌面模式"
                                    Checked="Mode_Checked"
                                    GroupName="LaunchMode"
                                    Style="{StaticResource ChoiceCardRadioStyle}">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="桌面模式" />
                                </RadioButton>

                                <RadioButton
                                    x:Name="ServerModeRadio"
                                    Grid.Column="2"
                                    AutomationProperties.Name="服务器模式"
                                    Checked="Mode_Checked"
                                    GroupName="LaunchMode"
                                    Style="{StaticResource ChoiceCardRadioStyle}">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="服务器模式" />
                                </RadioButton>
                            </Grid>

                            <!--  选中模式的说明，避免卡片里塞长文案导致折行  -->
                            <TextBlock
                                x:Name="ModeDescriptionText"
                                Style="{StaticResource FootnoteTextStyle}"
                                Text="用默认浏览器打开酒馆，适合日常对话。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!--  右列：随启动模式变化的设置  -->
                    <Border
                        x:Name="ModeSettingsPanel"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,16,0,0"
                        Padding="16"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubPanelStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="模式设置" />
                                <TextBlock
                                    x:Name="ModeSettingsTag"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MetricLabelTextStyle}"
                                    Text="普通模式" />
                            </Grid>

                            <!--  仅普通模式：默认浏览器  -->
                            <StackPanel x:Name="NormalModePanel" Spacing="10">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="默认浏览器" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton
                                        x:Name="ChromeRadio"
                                        AutomationProperties.Name="谷歌浏览器"
                                        Checked="Browser_Checked"
                                        Content="谷歌浏览器"
                                        GroupName="Browser"
                                        IsChecked="True"
                                        Style="{StaticResource ChoiceChipRadioStyle}" />
                                    <RadioButton
                                        x:Name="EdgeRadio"
                                        AutomationProperties.Name="Edge"
                                        Checked="Browser_Checked"
                                        Content="Edge"
                                        GroupName="Browser"
                                        Style="{StaticResource ChoiceChipRadioStyle}" />
                                    <RadioButton
                                        x:Name="FirefoxRadio"
                                        AutomationProperties.Name="火狐浏览器"
                                        Checked="Browser_Checked"
                                        Content="火狐浏览器"
                                        GroupName="Browser"
                                        Style="{StaticResource ChoiceChipRadioStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource FootnoteTextStyle}"
                                    Text="启动酒馆后自动用所选浏览器打开界面。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  仅桌面模式：无需额外设置，给出说明避免面板空掉  -->
                            <StackPanel
                                x:Name="DesktopModePanel"
                                Spacing="10"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource IconTileSmallStyle}">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE7F4;" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CellTextStyle}"
                                        Text="独立窗口运行" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource FootnoteTextStyle}"
                                    Text="酒馆界面在独立窗口中打开，不经过浏览器，也无需配置网络访问方式。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  仅服务器模式：服务模式  -->
                            <StackPanel
                                x:Name="ServerModePanel"
                                Spacing="10"
                                Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="服务模式" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton
                                        x:Name="LanRadio"
                                        AutomationProperties.Name="局域网"
                                        Checked="ServiceScope_Checked"
                                        Content="局域网"
                                        GroupName="ServiceScope"
                                        IsChecked="True"
                                        Style="{StaticResource ChoiceChipRadioStyle}" />
                                    <RadioButton
                                        x:Name="WanRadio"
                                        AutomationProperties.Name="互联网"
                                        Checked="ServiceScope_Checked"
                                        Content="互联网"
                                        GroupName="ServiceScope"
                                        Style="{StaticResource ChoiceChipRadioStyle}" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="访问地址" />
                                    <TextBlock
                                        x:Name="AccessAddressText"
                                        Style="{StaticResource MonoTextStyle}"
                                        Text="http://192.168.1.24:8000"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="ServiceScopeHint"
                                    Style="{StaticResource FootnoteTextStyle}"
                                    Text="同一 Wi-Fi 下的设备可直接访问，无需额外配置。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ==================== 快捷操作 ====================  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="快捷操作" />
                            <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="常用动作集中在这里，无需切换页面" />
                        </StackPanel>
                        <HyperlinkButton
                            Padding="4,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OpenConsole_Click"
                            Content="查看日志" />
                    </Grid>

                    <Grid
                        x:Name="QuickGrid"
                        ColumnSpacing="10"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="QaCol2" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="Qa1"
                            Click="OpenTavern_Click"
                            AutomationProperties.Name="打开酒馆"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE774;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="打开酒馆" />
                                    <TextBlock
                                        x:Name="OpenTavernHint"
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="用 谷歌浏览器 打开" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="Qa2"
                            Grid.Column="1"
                            Click="OpenConsole_Click"
                            AutomationProperties.Name="打开控制台"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE756;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="控制台" />
                                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="查看实时日志" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="Qa3"
                            Grid.Column="2"
                            Click="OpenDataDir_Click"
                            AutomationProperties.Name="打开数据目录"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8B7;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="数据目录" />
                                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="配置与角色卡" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="Qa4"
                            Grid.Row="1"
                            Click="ImportCard_Click"
                            AutomationProperties.Name="导入角色卡"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE77B;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="导入角色卡" />
                                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="PNG / JSON" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="Qa5"
                            Grid.Row="1"
                            Grid.Column="1"
                            Click="CopyEndpoint_Click"
                            AutomationProperties.Name="复制服务地址"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE8C8;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="复制地址" />
                                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="分享给其他设备" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="Qa6"
                            Grid.Row="1"
                            Grid.Column="2"
                            Click="OpenConfig_Click"
                            AutomationProperties.Name="打开酒馆配置"
                            Style="{StaticResource QuickActionButtonStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileSmallStyle}">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE713;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="酒馆配置" />
                                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="模型与端口" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
