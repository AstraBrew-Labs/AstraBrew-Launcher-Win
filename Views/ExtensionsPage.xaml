<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.ExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="扩展管理" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="管理已安装的酒馆扩展与正则、快捷回复等增强模块。" />
            </StackPanel>

            <!--  工具栏  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    PlaceholderText="搜索扩展…"
                    QueryIcon="Find" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Content="安装扩展" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="检查更新" />
                    <Button Content="打开扩展目录" />
                </StackPanel>
            </Grid>

            <!--  扩展列表  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="0">

                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource CardTitleTextStyle}"
                        Text="已安装扩展 · 12 个" />

                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="扩展名称" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ColumnHeaderTextStyle}"
                            Text="版本" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource ColumnHeaderTextStyle}"
                            Text="状态" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource ColumnHeaderTextStyle}"
                            Text="启用" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="长期记忆" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="向量检索式长期记忆，支持自动摘要" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="2.1.0" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="已启用" />
                        <ToggleSwitch
                            Grid.Column="3"
                            MinWidth="0"
                            HorizontalAlignment="Left"
                            IsOn="True"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="语音合成" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="接入本地 TTS 引擎，输出语音回复" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="1.0.4" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="可更新" />
                        <ToggleSwitch
                            Grid.Column="3"
                            MinWidth="0"
                            HorizontalAlignment="Left"
                            IsOn="True"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="变量脚本" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="在提示词中注入运行时变量" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="0.9.2" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="已停止" />
                        <ToggleSwitch
                            Grid.Column="3"
                            MinWidth="0"
                            HorizontalAlignment="Left"
                            IsOn="False"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="界面主题包" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="为酒馆前端替换配色与字体" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="3.2.0" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="已启用" />
                        <ToggleSwitch
                            Grid.Column="3"
                            MinWidth="0"
                            HorizontalAlignment="Left"
                            IsOn="True"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
