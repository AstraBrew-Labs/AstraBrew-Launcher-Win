<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  分组标题：17 / SemiBold，与卡片里的 13 号行标题拉开两级  -->
        <Style x:Key="SectionHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  行间分隔线：与卡片同宽，靠上下 0 边距紧贴两行  -->
        <Style x:Key="RowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--  行内开关：默认 MinWidth=154 会把轨道推到左边留一大块空白，这里钉死成轨道宽  -->
        <Style x:Key="RowSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  行内小按钮：比标准 32 更紧凑，字号回落到 13  -->
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="880" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  页头：保存态与「恢复默认设置」落到标题下方  -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="2" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />

                        <!--  窄窗收窄左右留白，把宽度让给设置行  -->
                        <Setter Target="PageRoot.Padding" Value="20,20,20,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" Style="{StaticResource PageRootStyle}">

                <!--  ==================== 页头 ====================  -->
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="设置" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="外观、启动行为、运行环境与网络。改动即时保存，下次启动沿用。" />
                    </StackPanel>

                    <StackPanel
                        x:Name="HeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Bottom">
                        <Border x:Name="SavePill" Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    x:Name="SaveDot"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock
                                    x:Name="SaveStateText"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    Text="已生效" />
                            </StackPanel>
                        </Border>

                        <Button Click="RestoreDefaults_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE7A7;" />
                                <TextBlock Text="恢复默认设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ==================== 界面 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE790;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="界面" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="语言、主题、缩放与字体；这些选项只影响启动器本身。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="菜单与提示文案使用的语言，跟随系统时读取 Windows 显示语言。"
                                Glyph="&#xE774;"
                                Title="界面语言"
                                WrapAt="620">
                                <controls:SegmentedPicker
                                    x:Name="LanguagePicker"
                                    Options="跟随系统,简体中文,English"
                                    SelectionChanged="LanguagePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="浅色 / 深色只改应用内配色，窗口材质与系统保持一致。"
                                Glyph="&#xE9A9;"
                                Title="外观主题"
                                WrapAt="560">
                                <controls:SegmentedPicker
                                    x:Name="ThemePicker"
                                    Glyphs="E7F4,E9A9,E708"
                                    Options="跟随系统,浅色,深色"
                                    SelectionChanged="ThemePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="按比例放大全部文字与控件，适合高分屏或视力不佳时使用。"
                                Glyph="&#xE9E9;"
                                Title="界面缩放"
                                WrapAt="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Slider
                                        x:Name="ScaleSlider"
                                        Width="200"
                                        Maximum="140"
                                        Minimum="90"
                                        StepFrequency="5"
                                        Value="100"
                                        ValueChanged="ScaleSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="ScaleValueText"
                                        Width="46"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="100%"
                                        TextAlignment="Right" />
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="中文缺字时自动回退到系统字体，仅影响观感。"
                                Glyph="&#xE8D2;"
                                Title="界面字体"
                                WrapAt="620">
                                <ComboBox
                                    x:Name="FontCombo"
                                    Width="260"
                                    SelectionChanged="FontCombo_SelectionChanged">
                                    <ComboBoxItem Content="系统默认（Segoe UI Variable）" />
                                    <ComboBoxItem Content="思源黑体 / 更圆润" />
                                    <ComboBoxItem Content="等宽（Cascadia Mono）" />
                                </ComboBox>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="退出时记住窗口大小与位置，下次在原处打开。"
                                Glyph="&#xE737;"
                                Title="记住窗口位置"
                                WrapAt="0">
                                <ToggleSwitch
                                    x:Name="RememberWindowSwitch"
                                    Style="{StaticResource RowSwitchStyle}"
                                    Toggled="RememberWindowSwitch_Toggled" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 基础 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE713;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="基础" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启动时机、资源分配与酒馆的默认启动方式。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="登录 Windows 后自动启动；需要改动时请到系统「启动应用」里调整。"
                                Glyph="&#xE7E8;"
                                Title="开机自动启动"
                                WrapAt="560">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleSwitch
                                        x:Name="AutoLaunchSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="AutoLaunchSwitch_Toggled" />
                                    <Button
                                        Click="OpenStartupSettings_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        ToolTipService.ToolTip="打开系统「启动应用」设置">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                            <TextBlock Text="系统设置" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="扫盘、解压与构建时的并行度；自动会按机器负载取一半核心。"
                                Glyph="&#xE950;"
                                Title="占用 CPU 核心"
                                WrapAt="500">
                                <controls:SegmentedPicker
                                    x:Name="CpuPicker"
                                    Options="自动,一半,全部"
                                    SelectionChanged="CpuPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="普通模式在浏览器里打开，桌面模式套一层独立窗口。"
                                Glyph="&#xE768;"
                                Title="默认启动方式"
                                WrapAt="620">
                                <controls:SegmentedPicker
                                    x:Name="StartModePicker"
                                    Glyphs="E774,E7F4"
                                    Options="普通模式,桌面模式"
                                    SelectionChanged="StartModePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <!--  仅桌面模式与这两项有关：普通模式在浏览器里跑，没有可停止的宿主窗口  -->
                            <StackPanel x:Name="DesktopRows" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    Description="关闭桌面窗口时顺带结束后台进程，避免留下占端口的孤儿进程。"
                                    Glyph="&#xE71A;"
                                    Title="关闭窗口时停止酒馆"
                                    WrapAt="0">
                                    <ToggleSwitch
                                        x:Name="StopOnCloseSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="StopOnCloseSwitch_Toggled" />
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    Description="角色卡、世界书等资源默认导出的位置。"
                                    Glyph="&#xE8B7;"
                                    Title="资源保存路径"
                                    WrapAt="720">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="280"
                                            Padding="10,7"
                                            Style="{StaticResource SubPanelStyle}">
                                            <TextBlock
                                                x:Name="ExportPathText"
                                                Style="{StaticResource MonoTextStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button
                                            Click="PickExportPath_Click"
                                            Content="更改"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            AutomationProperties.Name="打开资源目录"
                                            Click="OpenExportPath_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="在资源管理器中打开">
                                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="允许局域网 / 公网访问酒馆；关闭时只有本机能连。"
                                Glyph="&#xE968;"
                                Title="服务器模式"
                                WrapAt="0">
                                <ToggleSwitch
                                    x:Name="ServerModeSwitch"
                                    Style="{StaticResource RowSwitchStyle}"
                                    Toggled="ServerModeSwitch_Toggled" />
                            </controls:SettingRow>

                            <StackPanel x:Name="ServerRows" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    Description="局域网只对同一网段开放；互联网需要反代与域名。"
                                    Glyph="&#xE704;"
                                Title="服务范围"
                                WrapAt="650">
                                    <controls:SegmentedPicker
                                        x:Name="ScopePicker"
                                        Glyphs="E704,E774"
                                        Options="局域网,互联网"
                                        SelectionChanged="ScopePicker_SelectionChanged" />
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    Description="交给 PM2 托管，关掉启动器后酒馆继续运行。"
                                    Glyph="&#xE9F5;"
                                    Title="关闭启动器后继续运行"
                                    WrapAt="560">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ToggleSwitch
                                            x:Name="BackgroundSwitch"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="BackgroundSwitch_Toggled" />
                                        <Border
                                            x:Name="BackgroundBlockedPill"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Style="{StaticResource StatePillStyle}"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                Style="{StaticResource StatePillTextStyle}"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Text="需要 PM2" />
                                        </Border>
                                    </StackPanel>
                                </controls:SettingRow>

                                <StackPanel x:Name="InternetRows" Visibility="Collapsed">
                                    <Rectangle Style="{StaticResource RowDividerStyle}" />

                                    <controls:SettingRow
                                        Description="把公网请求转发到本机端口，需要 Caddy 与域名解析。"
                                        Glyph="&#xE8AB;"
                                        Title="反向代理"
                                        WrapAt="0">
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="尚未开放" />
                                        </Border>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="全局共享让多个实例共用一份角色卡；独立存放便于整体迁移。"
                                Glyph="&#xE8B7;"
                                Title="数据存放"
                                WrapAt="600">
                                <controls:SegmentedPicker
                                    x:Name="DataLocationPicker"
                                    Options="全局共享,随实例"
                                    SelectionChanged="DataLocationPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="全局共享模式下，角色卡与设置实际存放在这里。"
                                Glyph="&#xE8E5;"
                                Title="全局数据目录"
                                WrapAt="720">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="280"
                                        Padding="10,7"
                                        Style="{StaticResource SubPanelStyle}">
                                        <TextBlock
                                            x:Name="GlobalDataPathText"
                                            Style="{StaticResource MonoTextStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button
                                        Click="PickGlobalDataPath_Click"
                                        Content="更改"
                                        Style="{StaticResource RowButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="打开数据目录"
                                        Click="OpenGlobalDataPath_Click"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        ToolTipService.ToolTip="在资源管理器中打开">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 控制台 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F8E44DC"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF8E44DC" Glyph="&#xE756;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="控制台" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="日志与命令回显的显示方式。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="在日志里回显实际执行的命令与参数，排查启动失败时很有用。"
                                Glyph="&#xE756;"
                                Title="显示启动命令"
                                WrapAt="0">
                                <ToggleSwitch
                                    x:Name="StartupCommandSwitch"
                                    Style="{StaticResource RowSwitchStyle}"
                                    Toggled="StartupCommandSwitch_Toggled" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 运行环境 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F16A34A"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF16A34A" Glyph="&#xE964;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="运行环境" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="酒馆依赖的 Git、Node.js、PM2 等组件；内置环境与系统环境各有一套版本。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="内置环境装在启动器目录里，可随启动器一起搬走；系统环境由你自己维护。"
                                Glyph="&#xE90F;"
                                Title="环境来源"
                                WrapAt="680">
                                <controls:SegmentedPicker
                                    x:Name="RuntimePicker"
                                    Glyphs="E7B8,E774"
                                    Options="内置环境,系统环境"
                                    SelectionChanged="RuntimePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="GitRow"
                                Description="拉取与更新酒馆源码。"
                                Glyph="&#xE8AB;"
                                Title="Git"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="GitVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="GitInstallButton"
                                        Click="InstallGit_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock Text="安装" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="NodeRow"
                                Description="运行酒馆与全部扩展的 JavaScript 运行时。"
                                Glyph="&#xE943;"
                                Title="Node.js"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="NodeVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Border
                                        x:Name="NodeOutdatedPill"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Style="{StaticResource StatePillStyle}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Style="{StaticResource StatePillTextStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Text="可更新" />
                                    </Border>
                                    <Button
                                        x:Name="NodeInstallButton"
                                        Click="InstallNode_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock Text="安装" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="NpmRow"
                                Description="安装扩展与 PM2 时使用的包源。"
                                Glyph="&#xE774;"
                                Title="npm 包源"
                                WrapAt="700">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                                    <controls:SegmentedPicker
                                        x:Name="NpmPicker"
                                        HorizontalAlignment="Right"
                                        Options="npmmirror,华为云,腾讯云,官方"
                                        SelectionChanged="NpmPicker_SelectionChanged" />
                                    <TextBlock
                                        x:Name="NpmUrlText"
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="CaddyRow"
                                Description="服务器模式下负责反向代理与 HTTPS。"
                                Glyph="&#xE72E;"
                                Title="Caddy"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="CaddyVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="CaddyInstallButton"
                                        Click="InstallCaddy_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock Text="安装" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="Pm2Row"
                                Description="后台常驻与崩溃自启；全局 npm 包，必须先有 Node.js。"
                                Glyph="&#xE9F5;"
                                Title="PM2"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="Pm2VersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="Pm2NoteText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="需先安装 Node.js"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="Pm2InstallButton"
                                        Click="InstallPm2_Click"
                                        Style="{StaticResource RowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock Text="安装" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="WebView2Row"
                                Description="桌面模式的内嵌浏览器内核，随 Edge 一起更新。"
                                Glyph="&#xE774;"
                                Title="WebView2 运行时"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="WebView2VersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="WebView2InstallButton"
                                        Click="InstallWebView2_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock Text="安装" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 下载 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE896;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="下载" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="从 GitHub 取源码与依赖包时走哪条通道；国内直连经常超时，反代更稳。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                x:Name="ChannelRow"
                                Glyph="&#xE8AB;"
                                Title="下载通道"
                                WrapAt="760">
                                <controls:SegmentedPicker
                                    x:Name="ChannelPicker"
                                    Options="自动,gh-proxy.org,ghfast.top,官方"
                                    SelectionChanged="ChannelPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="自动通道依赖最近一次测速结果，超过 15 分钟会标记为过期。"
                                Glyph="&#xE72C;"
                                Title="通道测速缓存"
                                WrapAt="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            x:Name="ChannelCacheText"
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Name="ChannelCacheHintText"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        x:Name="RetestButton"
                                        Click="RetestChannel_Click"
                                        Style="{StaticResource RowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE895;" />
                                            <TextBlock Text="测速" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 网络 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F0E9AA7"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF0E9AA7" Glyph="&#xE774;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="网络" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="访问 GitHub 与 npm 时使用的代理；系统代理跟随 Windows 的 Internet 选项。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                x:Name="ProxyRow"
                                Glyph="&#xE71B;"
                                Title="代理方式"
                                WrapAt="700">
                                <controls:SegmentedPicker
                                    x:Name="ProxyPicker"
                                    Glyphs="E72E,E7F4,E774"
                                    Options="不使用,系统代理,自定义"
                                    SelectionChanged="ProxyPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <StackPanel x:Name="CustomProxyRows" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    Description="支持 http 与 socks5；带认证时写成 http://user:pass@host:port。"
                                    Glyph="&#xE71B;"
                                    Title="代理地址"
                                    WrapAt="660">
                                    <TextBox
                                        x:Name="CustomProxyBox"
                                        Width="322"
                                        PlaceholderText="http://127.0.0.1:7890"
                                        TextChanged="CustomProxyBox_TextChanged" />
                                </controls:SettingRow>
                            </StackPanel>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="依次访问 GitHub 的网页、API 与下载域名，找出当前能跑通的那条。"
                                Glyph="&#xE968;"
                                Title="GitHub 连通性"
                                WrapAt="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="GithubTestText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="未测试" />
                                    <Button
                                        x:Name="GithubTestButton"
                                        Click="TestGithub_Click"
                                        Style="{StaticResource RowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xEC4A;" />
                                            <TextBlock Text="开始测试" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 更新 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE895;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="更新" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启动器自身的版本；酒馆与扩展在各自页面单独更新。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="当前安装的启动器版本，稳定通道。"
                                Glyph="&#xE7B8;"
                                Title="AstraBrew Launcher"
                                WrapAt="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock x:Name="VersionChipText" Style="{StaticResource MetaChipTextStyle}" Text="v0.1.0" />
                                    </Border>
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="稳定通道" />
                                    </Border>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="发现新版本时会先展示发行说明，确认后才下载安装。"
                                Glyph="&#xE896;"
                                Title="检查更新"
                                WrapAt="560">
                                <Button
                                    x:Name="CheckUpdateButton"
                                    Click="CheckUpdate_Click"
                                    Style="{StaticResource RowButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE895;" />
                                        <TextBlock x:Name="CheckUpdateLabel" Text="检查更新" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 原型工具 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F8A93A0"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF8A93A0" Glyph="&#xE90F;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" Text="原型工具" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="原型阶段的辅助入口，正式版会移除。" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                Description="清除「已完成引导」标记并立刻重新展示，用于反复演示。"
                                Glyph="&#xE768;"
                                Title="重新播放首次引导"
                                WrapAt="560">
                                <Button
                                    Click="ReplayOnboarding_Click"
                                    Content="重新演示"
                                    Style="{StaticResource RowButtonStyle}" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                Description="引导标记落在这个文件里；删掉它等同于「从未引导过」。"
                                Glyph="&#xE8A5;"
                                Title="标记文件"
                                WrapAt="700">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="322"
                                        Padding="10,7"
                                        Style="{StaticResource SubPanelStyle}">
                                        <TextBlock
                                            x:Name="OnboardingPathText"
                                            Style="{StaticResource MonoTextStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button
                                        AutomationProperties.Name="复制标记文件路径"
                                        Click="CopyOnboardingPath_Click"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        ToolTipService.ToolTip="复制完整路径">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="打开配置目录"
                                        Click="OpenConfigDir_Click"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        ToolTipService.ToolTip="打开所在目录">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
