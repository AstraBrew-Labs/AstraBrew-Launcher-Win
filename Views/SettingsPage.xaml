<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  分组标题：17 / SemiBold，与卡片里的 13 号行标题拉开两级  -->
        <Style x:Key="SectionHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  行间分隔线：与卡片同宽，靠上下 0 边距紧贴两行  -->
        <Style x:Key="RowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--  行内开关：默认 MinWidth=154 会把轨道推到左边留一大块空白，这里钉死成轨道宽  -->
        <Style x:Key="RowSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  行内小按钮：比标准 32 更紧凑，字号回落到 13  -->
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="880" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  页头：保存态与「恢复默认设置」落到标题下方  -->
                        <Setter Target="HeaderActions.(Grid.Row)" Value="2" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />

                        <!--  窄窗收窄左右留白，把宽度让给设置行  -->
                        <Setter Target="PageRoot.Padding" Value="20,20,20,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" Style="{StaticResource PageRootStyle}">

                <!--  ==================== 页头 ====================  -->
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" controls:Loc.Text="Settings.Page.Title" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" controls:Loc.Text="Settings.Page.Subtitle" />
                    </StackPanel>

                    <StackPanel
                        x:Name="HeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Bottom">
                        <Border x:Name="SavePill" Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    x:Name="SaveDot"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock
                                    x:Name="SaveStateText"
                                    Style="{StaticResource StatusPillTextStyle}"
                                    controls:Loc.Text="Settings.Save.Saved" />
                            </StackPanel>
                        </Border>

                        <Button Click="RestoreDefaults_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE7A7;" />
                                <TextBlock controls:Loc.Text="Settings.Page.RestoreDefaults" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  ==================== 配置版本 ====================  -->
                <Border
                    Padding="16,12"
                    Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SegmentTrackStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <RadioButton
                                    x:Name="SimpleLevelRadio"
                                    controls:Loc.Name="Settings.Level.Simple.Label"
                                    Checked="LevelRadio_Checked"
                                    GroupName="SettingsLevel"
                                    Style="{StaticResource SegmentRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                                        <TextBlock controls:Loc.Text="Settings.Level.Simple.Label" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton
                                    x:Name="AdvancedLevelRadio"
                                    controls:Loc.Name="Settings.Level.Advanced.Label"
                                    Checked="LevelRadio_Checked"
                                    GroupName="SettingsLevel"
                                    Style="{StaticResource SegmentRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE943;" />
                                        <TextBlock controls:Loc.Text="Settings.Level.Advanced.Label" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="LevelTitle" Style="{StaticResource CellTitleTextStyle}" />
                                <TextBlock
                                    x:Name="LevelHint"
                                    Style="{StaticResource FieldHintTextStyle}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="LevelCount"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FootnoteTextStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  ==================== 界面 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE790;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Appearance.Title" />
                            <TextBlock x:Name="UiSectionHint" Style="{StaticResource FieldHintTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <!--  标题/说明由代码按资源填（自定依赖属性不吃 x:Uid），见 ApplyLocalizedRows()  -->
                            <controls:SettingRow
                                TitleKey="Settings.Row.Language.Title"
                                DescriptionKey="Settings.Row.Language.Description"
                                x:Name="LanguageRow"
                                Glyph="&#xE774;"
                                WrapAt="660">
                                <controls:SegmentedPicker
                                    x:Name="LanguagePicker"
                                    OptionsKey="Settings.Language.Option"
                                    SelectionChanged="LanguagePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                DescriptionKey="Settings.Row.Theme.Description"
                                Glyph="&#xE9A9;"
                                TitleKey="Settings.Row.Theme.Title"
                                WrapAt="560">
                                <controls:SegmentedPicker
                                    x:Name="ThemePicker"
                                    Glyphs="E7F4,E9A9,E708"
                                    OptionsKey="Settings.Theme.Option"
                                    SelectionChanged="ThemePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle x:Name="DividerBeforeScale" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="ScaleRow"
                                DescriptionKey="Settings.Row.Scale.Description"
                                Glyph="&#xE9E9;"
                                TitleKey="Settings.Row.Scale.Title"
                                WrapAt="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Slider
                                        x:Name="ScaleSlider"
                                        Width="200"
                                        Maximum="140"
                                        Minimum="90"
                                        StepFrequency="5"
                                        Value="100"
                                        ValueChanged="ScaleSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="ScaleValueText"
                                        Width="46"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="100%"
                                        TextAlignment="Right" />
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle x:Name="DividerBeforeFont" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="FontRow"
                                Description=""
                                Glyph="&#xE8D2;"
                                TitleKey="Settings.Row.Font.Title"
                                WrapAt="620">
                                <!--  条目由 SettingsPage.BuildFontList 动态填充：首项是内置的「软件默认」，其余是本机已装字体  -->
                                <ComboBox
                                    x:Name="FontCombo"
                                    Width="300"
                                    MaxDropDownHeight="420"
                                    controls:Loc.Placeholder="Common.Choose"
                                    SelectionChanged="FontCombo_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                DescriptionKey="Settings.Row.WindowPlacement.Description"
                                Glyph="&#xE737;"
                                TitleKey="Settings.Row.WindowPlacement.Title"
                                WrapAt="0">
                                <ToggleSwitch
                                    x:Name="RememberWindowSwitch"
                                    Style="{StaticResource RowSwitchStyle}"
                                    Toggled="RememberWindowSwitch_Toggled" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 基础 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE713;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Basics.Title" />
                            <TextBlock x:Name="BasicSectionHint" Style="{StaticResource FieldHintTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                DescriptionKey="Settings.Row.AutoStart.Description"
                                Glyph="&#xE7E8;"
                                TitleKey="Settings.Row.AutoStart.Title"
                                WrapAt="560">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleSwitch
                                        x:Name="AutoLaunchSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="AutoLaunchSwitch_Toggled" />
                                    <Button
                                        Click="OpenStartupSettings_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        controls:Loc.ToolTip="Settings.Row.AutoLaunch.Tip.OpenSettings">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                            <TextBlock controls:Loc.Text="Common.OpenSettings" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="CpuRow"
                                DescriptionKey="Settings.Row.CpuCores.Description"
                                Glyph="&#xE950;"
                                TitleKey="Settings.Row.CpuCores.Title"
                                WrapAt="500">
                                <controls:SegmentedPicker
                                    x:Name="CpuPicker"
                                    OptionsKey="Settings.Cpu.Option"
                                    SelectionChanged="CpuPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle x:Name="DividerAfterCpu" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                DescriptionKey="Settings.Row.StartMode.Description"
                                Glyph="&#xE768;"
                                TitleKey="Settings.Row.StartMode.Title"
                                WrapAt="620">
                                <controls:SegmentedPicker
                                    x:Name="StartModePicker"
                                    Glyphs="E774,E7F4,E968"
                                    OptionsKey="Settings.StartMode.Option"
                                    SelectionChanged="StartModePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <!--  仅桌面模式与这几项有关：普通模式在浏览器里跑，没有可停止 / 可记位置的宿主窗口  -->
                            <StackPanel x:Name="DesktopRows" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.StopOnClose.Description"
                                    Glyph="&#xE71A;"
                                    TitleKey="Settings.Row.StopOnClose.Title"
                                    WrapAt="0">
                                    <ToggleSwitch
                                        x:Name="StopOnCloseSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="StopOnCloseSwitch_Toggled" />
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.TavernPlacement.Description"
                                    Glyph="&#xE707;"
                                    TitleKey="Settings.Row.TavernPlacement.Title"
                                    WrapAt="0">
                                    <ToggleSwitch
                                        x:Name="RememberTavernSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="RememberTavernSwitch_Toggled" />
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.WebViewMemory.Description"
                                    Glyph="&#xE950;"
                                    TitleKey="Settings.Row.WebViewMemory.Title"
                                    WrapAt="620">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Slider
                                            x:Name="MemorySlider"
                                            Width="200"
                                            Minimum="1024"
                                            Maximum="4096"
                                            StepFrequency="512"
                                            Value="2048"
                                            ValueChanged="MemorySlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="MemoryValueText"
                                            Width="64"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="2 GB"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.ExportPath.Description"
                                    Glyph="&#xE8B7;"
                                    TitleKey="Settings.Row.ExportPath.Title"
                                    WrapAt="720">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Width="280"
                                            Padding="10,7"
                                            Style="{StaticResource SubPanelStyle}">
                                            <TextBlock
                                                x:Name="ExportPathText"
                                                Style="{StaticResource MonoTextStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button
                                            Click="PickExportPath_Click"
                                            controls:Loc.Content="Common.Change"
                                            Style="{StaticResource RowButtonStyle}" />
                                        <Button
                                            controls:Loc.Name="Common.OpenFolder"
                                            Click="OpenExportPath_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            controls:Loc.ToolTip="Common.RevealInExplorer">
                                            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingRow>
                            </StackPanel>

                            <!--  服务器模式的子选项：启动方式选了「服务器模式」才展开  -->
                            <StackPanel x:Name="ServerRows" Visibility="Collapsed">
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.BindScope.Description"
                                    Glyph="&#xE704;"
                                TitleKey="Settings.Row.BindScope.Title"
                                WrapAt="650">
                                    <controls:SegmentedPicker
                                        x:Name="ScopePicker"
                                        Glyphs="E704,E774"
                                        OptionsKey="Settings.Reach.Option"
                                        SelectionChanged="ScopePicker_SelectionChanged" />
                                </controls:SettingRow>

                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    DescriptionKey="Settings.Row.KeepRunning.Description"
                                    Glyph="&#xE9F5;"
                                    TitleKey="Settings.Row.KeepRunning.Title"
                                    WrapAt="560">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ToggleSwitch
                                            x:Name="BackgroundSwitch"
                                            Style="{StaticResource RowSwitchStyle}"
                                            Toggled="BackgroundSwitch_Toggled" />
                                        <Border
                                            x:Name="BackgroundBlockedPill"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Style="{StaticResource StatePillStyle}"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                Style="{StaticResource StatePillTextStyle}"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                controls:Loc.Text="Settings.Runtime.NeedsPm2" />
                                        </Border>
                                    </StackPanel>
                                </controls:SettingRow>

                                <StackPanel x:Name="InternetRows" Visibility="Collapsed">
                                    <Rectangle Style="{StaticResource RowDividerStyle}" />

                                    <controls:SettingRow
                                        DescriptionKey="Settings.Row.ReverseProxy.Description"
                                        Glyph="&#xE8AB;"
                                        TitleKey="Settings.Row.ReverseProxy.Title"
                                        WrapAt="0">
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock Style="{StaticResource MetaChipTextStyle}" controls:Loc.Text="Settings.Runtime.NotAvailable" />
                                        </Border>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle x:Name="DividerBeforeDataLocation" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="DataLocationRow"
                                DescriptionKey="Settings.Row.DataLocation.Description"
                                Glyph="&#xE8B7;"
                                TitleKey="Settings.Row.DataLocation.Title"
                                WrapAt="600">
                                <controls:SegmentedPicker
                                    x:Name="DataLocationPicker"
                                    OptionsKey="Settings.DataLocation.Option"
                                    SelectionChanged="DataLocationPicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle x:Name="DividerBeforeGlobalData" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="GlobalDataRow"
                                DescriptionKey="Settings.Row.GlobalData.Description"
                                Glyph="&#xE8E5;"
                                TitleKey="Settings.Row.GlobalData.Title"
                                WrapAt="720">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="280"
                                        Padding="10,7"
                                        Style="{StaticResource SubPanelStyle}">
                                        <TextBlock
                                            x:Name="GlobalDataPathText"
                                            Style="{StaticResource MonoTextStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button
                                        controls:Loc.Name="Common.OpenDataFolder"
                                        Click="OpenGlobalDataPath_Click"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        controls:Loc.ToolTip="Common.RevealInExplorer">
                                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 控制台 ====================  -->
                <StackPanel x:Name="ConsoleSection" Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F8E44DC"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF8E44DC" Glyph="&#xE756;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Console.Title" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" controls:Loc.Text="Settings.Group.Console.Hint" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                DescriptionKey="Settings.Row.EchoCommands.Description"
                                Glyph="&#xE756;"
                                TitleKey="Settings.Row.EchoCommands.Title"
                                WrapAt="0">
                                <ToggleSwitch
                                    x:Name="StartupCommandSwitch"
                                    Style="{StaticResource RowSwitchStyle}"
                                    Toggled="StartupCommandSwitch_Toggled" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 运行环境 ====================  -->
                <StackPanel x:Name="RuntimeSection" Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F16A34A"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF16A34A" Glyph="&#xE964;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Runtime.Title" />
                            <TextBlock x:Name="RuntimeSectionHint" Style="{StaticResource FieldHintTextStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="RecheckEnvironmentButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="RecheckEnvironment_Click"
                            Style="{StaticResource RowButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                <TextBlock controls:Loc.Text="Common.Recheck" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <!--
                                小白版：把五个组件收成一行结论 —— 三项必要环境齐了就是「正常」，
                                缺任意一项才出现「修复」，不让人对着一排版本来回对照。
                            -->
                            <controls:SettingRow
                                x:Name="RuntimeSummaryRow"
                                Description=""
                                Glyph="&#xE964;"
                                TitleKey="Settings.Row.RuntimeSummary.Title"
                                Visibility="Collapsed"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border x:Name="RuntimeStatePill" Style="{StaticResource StatePillStyle}">
                                        <TextBlock
                                            x:Name="RuntimeStateText"
                                            Style="{StaticResource StatePillTextStyle}"
                                            controls:Loc.Text="Settings.Runtime.State.Pending" />
                                    </Border>
                                    <Button
                                        x:Name="RepairRuntimeButton"
                                        Click="RepairRuntime_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE90F;" />
                                            <TextBlock controls:Loc.Text="Common.Fix" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <StackPanel x:Name="AdvancedRuntimeRows">
                            <controls:SettingRow
                                DescriptionKey="Settings.Row.RuntimeSource.Description"
                                Glyph="&#xE90F;"
                                TitleKey="Settings.Row.RuntimeSource.Title"
                                WrapAt="680">
                                <controls:SegmentedPicker
                                    x:Name="RuntimePicker"
                                    Glyphs="E7B8,E774"
                                    OptionsKey="Settings.RuntimeSource.Option"
                                    SelectionChanged="RuntimePicker_SelectionChanged" />
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="GitRow"
                                Description=""
                                Glyph="&#xE8AB;"
                                TitleKey="Settings.Row.Git.Title"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="GitVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="GitInstallButton"
                                        Click="InstallGit_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock controls:Loc.Text="Common.Install" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="NodeRow"
                                Description=""
                                Glyph="&#xE943;"
                                TitleKey="Settings.Row.Node.Title"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="NodeVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Border
                                        x:Name="NodeOutdatedPill"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        Style="{StaticResource StatePillStyle}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Style="{StaticResource StatePillTextStyle}"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            controls:Loc.Text="Settings.Runtime.VersionLow" />
                                    </Border>
                                    <Button
                                        x:Name="NodeInstallButton"
                                        Click="InstallNode_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock controls:Loc.Text="Common.Install" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <!--  npm 是 Node.js 的附带品：Node 没装时「npm」与「npm 包源」两行连同分隔线一起收起  -->
                            <Rectangle
                                x:Name="DividerBeforeNpm"
                                Style="{StaticResource RowDividerStyle}"
                                Visibility="Collapsed" />

                            <controls:SettingRow
                                x:Name="NpmRow"
                                DescriptionKey="Settings.Row.Npm.Description"
                                Glyph="&#xE774;"
                                TitleKey="Settings.Row.Npm.Title"
                                Visibility="Collapsed"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="NpmVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </controls:SettingRow>

                            <!--  包源是 npm 的一项设置，和「npm 装没装、什么版本」分开一行，别挤在一起  -->
                            <Rectangle
                                x:Name="DividerBeforeNpmRegistry"
                                Style="{StaticResource RowDividerStyle}"
                                Visibility="Collapsed" />

                            <controls:SettingRow
                                x:Name="NpmRegistryRow"
                                Description=""
                                Glyph="&#xE71B;"
                                TitleKey="Settings.Row.NpmRegistry.Title"
                                Visibility="Collapsed"
                                WrapAt="700">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                                    <controls:SegmentedPicker
                                        x:Name="NpmPicker"
                                        HorizontalAlignment="Right"
                                        OptionsKey="Settings.NpmRegistry.Option"
                                        SelectionChanged="NpmPicker_SelectionChanged" />
                                    <TextBlock
                                        x:Name="NpmUrlText"
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="CaddyRow"
                                Description=""
                                Glyph="&#xE72E;"
                                TitleKey="Settings.Row.Caddy.Title"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="CaddyVersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="CaddyInstallButton"
                                        Click="InstallCaddy_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock x:Name="CaddyInstallLabel" controls:Loc.Text="Common.Install" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="Pm2Row"
                                DescriptionKey="Settings.Row.Pm2.Description"
                                Glyph="&#xE9F5;"
                                TitleKey="Settings.Row.Pm2.Title"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="Pm2VersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="Pm2NoteText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        controls:Loc.Text="Settings.Runtime.NeedsNode"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="Pm2InstallButton"
                                        Click="InstallPm2_Click"
                                        Style="{StaticResource RowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock x:Name="Pm2InstallLabel" controls:Loc.Text="Common.Install" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                x:Name="WebView2Row"
                                DescriptionKey="Settings.Row.WebView2.Description"
                                Glyph="&#xE774;"
                                TitleKey="Settings.Row.WebView2.Title"
                                WrapAt="500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="WebView2VersionText"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Name="WebView2InstallButton"
                                        Click="InstallWebView2_Click"
                                        Style="{StaticResource RowButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                                            <TextBlock controls:Loc.Text="Common.Install" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 下载 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F2B88D8"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE896;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Download.Title" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" controls:Loc.Text="Settings.Group.Download.Hint" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <controls:SettingRow
                                x:Name="ChannelRow"
                                Glyph="&#xE8AB;"
                                TitleKey="Settings.Row.DownloadChannel.Title"
                                WrapAt="820">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                                    <controls:SegmentedPicker
                                        x:Name="ChannelPicker"
                                        HorizontalAlignment="Right"
                                        OptionsKey="Settings.Channel.Option"
                                        SelectionChanged="ChannelPicker_SelectionChanged" />
                                    <TextBlock
                                        x:Name="ChannelUrlText"
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </controls:SettingRow>

                            <!--
                                加速常显：一个开关管两件事——应用内的 GitHub 请求加前缀（HTTP/API/下载），
                                全局 git 配置写 insteadOf（命令行、酒馆自动更新、酒馆内装扩展）。
                                所以选镜像时它同样有意义，不能收起来。
                            -->
                            <StackPanel>
                                <Rectangle Style="{StaticResource RowDividerStyle}" />

                                <controls:SettingRow
                                    x:Name="AccelRow"
                                    Glyph="&#xE774;"
                                    TitleKey="Settings.Row.GithubAccel.Title"
                                    WrapAt="640">
                                    <ToggleSwitch
                                        x:Name="AccelSwitch"
                                        Style="{StaticResource RowSwitchStyle}"
                                        Toggled="AccelSwitch_Toggled" />
                                </controls:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 网络 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="#1F0E9AA7"
                            Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF0E9AA7" Glyph="&#xE774;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="Settings.Group.Network.Title" />
                            <TextBlock x:Name="NetworkSectionHint" Style="{StaticResource FieldHintTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <!--  小白版整组收起：代理是排障手段，日常用户只需知道 GitHub 通不通  -->
                            <StackPanel x:Name="ProxyGroup">
                                <controls:SettingRow
                                    x:Name="ProxyRow"
                                    Glyph="&#xE71B;"
                                    TitleKey="Settings.Row.ProxyMode.Title"
                                    WrapAt="700">
                                    <controls:SegmentedPicker
                                        x:Name="ProxyPicker"
                                        Glyphs="E72E,E7F4,E774"
                                        OptionsKey="Settings.Proxy.Option"
                                        SelectionChanged="ProxyPicker_SelectionChanged" />
                                </controls:SettingRow>

                                <!--
                                    跟随系统时把 Windows 的真实状态摆出来：
                                    「系统代理」这个词本身不说明任何事——Windows 那边可能压根没开代理。
                                -->
                                <StackPanel x:Name="SystemProxyRows" Visibility="Collapsed">
                                    <Rectangle Style="{StaticResource RowDividerStyle}" />

                                    <controls:SettingRow
                                        x:Name="SystemProxyRow"
                                        Description=""
                                        Glyph="&#xE968;"
                                        TitleKey="Settings.Row.SystemProxy.Title"
                                        WrapAt="700">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border x:Name="SystemProxyPill" Style="{StaticResource StatePillStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse
                                                        x:Name="SystemProxyDot"
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="SystemProxyPillText"
                                                        Style="{StaticResource StatePillTextStyle}"
                                                        controls:Loc.Text="Settings.Runtime.Reading" />
                                                </StackPanel>
                                            </Border>

                                            <Button
                                                Click="RefreshSystemProxy_Click"
                                                Style="{StaticResource RowButtonStyle}"
                                                controls:Loc.ToolTip="Settings.Proxy.Tip.Refresh">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                                    <TextBlock controls:Loc.Text="Common.Refresh" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Click="OpenWindowsProxy_Click"
                                                Style="{StaticResource RowButtonStyle}"
                                                controls:Loc.ToolTip="Settings.Proxy.Tip.OpenSettings">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                                    <TextBlock controls:Loc.Text="Common.OpenSettings" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </controls:SettingRow>
                                </StackPanel>

                                <StackPanel x:Name="CustomProxyRows" Visibility="Collapsed">
                                    <Rectangle Style="{StaticResource RowDividerStyle}" />

                                    <controls:SettingRow
                                        DescriptionKey="Settings.Row.ProxyAddress.Description"
                                        Glyph="&#xE71B;"
                                        TitleKey="Settings.Row.ProxyAddress.Title"
                                        WrapAt="660">
                                        <TextBox
                                            x:Name="CustomProxyBox"
                                            Width="322"
                                            PlaceholderText="http://127.0.0.1:7890"
                                            TextChanged="CustomProxyBox_TextChanged" />
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle x:Name="DividerBeforeGithub" Style="{StaticResource RowDividerStyle}" />

                            <controls:SettingRow
                                DescriptionKey="Settings.Row.GithubConnectivity.Description"
                                Glyph="&#xE968;"
                                TitleKey="Settings.Row.GithubConnectivity.Title"
                                WrapAt="620">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="GithubTestText"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        controls:Loc.Text="Settings.Row.GithubConnectivity.Idle" />
                                    <Button
                                        x:Name="GithubTestButton"
                                        Click="TestGithub_Click"
                                        Style="{StaticResource RowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xEC4A;" />
                                            <TextBlock controls:Loc.Text="Common.StartTest" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
