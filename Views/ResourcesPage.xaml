<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AstraBrew_Launcher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  ==================== 详情页内嵌的小条目 ====================  -->

        <!--  标签胶囊：只读，不做交互  -->
        <DataTemplate x:Key="TagItemTemplate" x:DataType="x:String">
            <Border Margin="0,0,6,0" Style="{StaticResource MetaChipStyle}">
                <TextBlock Text="{Binding}" Style="{StaticResource MetaChipTextStyle}" />
            </Border>
        </DataTemplate>

        <!--  键值信息格：由 ItemsRepeater 排版，窄窗自动退成单列  -->
        <DataTemplate x:Key="InfoCellTemplate" x:DataType="views:InfoCell">
            <Border Style="{StaticResource MetaCellStyle}">
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource MetaCellLabelStyle}" Text="{x:Bind Label}" />
                    <TextBlock Style="{StaticResource MetaCellValueStyle}" Text="{x:Bind Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  世界书条目：标题 + 启用状态 + 关键词 + 正文两行  -->
        <DataTemplate x:Key="WorldEntryItemTemplate" x:DataType="views:WorldEntryItem">
            <Border Padding="12,9,12,10" Style="{StaticResource SubPanelStyle}">
                <StackPanel Spacing="5">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            Style="{StaticResource StatePillStyle}"
                            Visibility="{x:Bind EnabledVisibility}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource StatePillTextStyle}"
                                Text="启用" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource StatePillStyle}"
                            Visibility="{x:Bind DisabledVisibility}">
                            <TextBlock Style="{StaticResource StatePillTextStyle}" Text="停用" />
                        </Border>
                    </Grid>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Keywords}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Text="{x:Bind Body}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  提示词条目：序号 + 名称 + role / 注入信息 + 启用态  -->
        <DataTemplate x:Key="PromptItemTemplate" x:DataType="views:PromptItem">
            <Border Padding="12,9,12,10" Style="{StaticResource SubPanelStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Index}" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource MetaChipStyle}">
                                <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="{x:Bind Role}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Position}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatePillStyle}"
                        Visibility="{x:Bind EnabledVisibility}">
                        <TextBlock Style="{StaticResource StatePillTextStyle}" Text="启用" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatePillStyle}"
                        Visibility="{x:Bind DisabledVisibility}">
                        <TextBlock Style="{StaticResource StatePillTextStyle}" Text="停用" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  对话消息：用户消息左侧多一道强调色竖条，其余保持中性  -->
        <DataTemplate x:Key="ChatMessageItemTemplate" x:DataType="views:ChatMessageItem">
            <Border Padding="12,10,12,11" Style="{StaticResource SubPanelStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="2"
                        CornerRadius="1"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind UserVisibility}" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind Speaker}" />
                            <Border
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MetaChipStyle}">
                                <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="{x:Bind Role}" />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="{x:Bind Time}" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Body}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  ==================== 四类资源的详情 ====================  -->

        <!--  角色卡：封面 + 规格格 + 正文小节 + 内嵌世界书  -->
        <DataTemplate x:Key="CharacterDetailTemplate" x:DataType="views:CharacterDetail">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="CoverTile"
                        Width="132"
                        Height="184"
                        Background="{x:Bind CoverBackground}"
                        CornerRadius="8">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="42"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind CoverForeground}"
                                Text="{x:Bind Monogram}" />
                            <Border
                                Margin="8"
                                Padding="6,1,6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="#4D000000"
                                CornerRadius="4">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{x:Bind ImageSize}" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <ItemsRepeater ItemTemplate="{StaticResource InfoCellTemplate}" ItemsSource="{x:Bind InfoCells}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="8"
                                    MinItemHeight="56"
                                    MinItemWidth="146"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <StackPanel Spacing="6" Visibility="{x:Bind TagsVisibility}">
                            <TextBlock Style="{StaticResource MetaCellLabelStyle}" Text="标签" />
                            <ItemsControl ItemsSource="{x:Bind Tags}" ItemTemplate="{StaticResource TagItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="简介" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="{x:Bind Description}" />
                    </StackPanel>
                </Border>

                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="性格" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="{x:Bind Personality}" />
                    </StackPanel>
                </Border>

                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="场景" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="{x:Bind Scenario}" />
                    </StackPanel>
                </Border>

                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="开场白" />
                        <TextBlock
                            FontSize="13"
                            FontStyle="Italic"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind FirstMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" Visibility="{x:Bind EntriesVisibility}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="内嵌世界书条目" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipTextStyle}"
                            Text="{x:Bind WorldLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Entries}" ItemTemplate="{StaticResource WorldEntryItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!--  世界书：指标 + 归属信息 + 条目列表  -->
        <DataTemplate x:Key="WorldBookDetailTemplate" x:DataType="views:WorldBookDetail">
            <StackPanel Spacing="14">

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="条目总数" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind EntryCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="已启用" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind EnabledCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="文件体积" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind SizeLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsRepeater ItemTemplate="{StaticResource InfoCellTemplate}" ItemsSource="{x:Bind InfoCells}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="56"
                            MinItemWidth="140"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="条目" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipTextStyle}"
                            Text="{x:Bind HintLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Entries}" ItemTemplate="{StaticResource WorldEntryItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!--  对话：指标 + 消息预览  -->
        <DataTemplate x:Key="ChatDetailTemplate" x:DataType="views:ChatDetail">
            <StackPanel Spacing="14">

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="消息条数" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind MessageCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="我的发言" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind UserCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="文件体积" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind SizeLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="对话预览" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipTextStyle}"
                            Text="{x:Bind HintLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Messages}" ItemTemplate="{StaticResource ChatMessageItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!--  预设：四枚指标 + 生成参数 + 提示词结构  -->
        <DataTemplate x:Key="PresetDetailTemplate" x:DataType="views:PresetDetail">
            <StackPanel Spacing="14">

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="提示词" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind PromptCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="已启用" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind EnabledCount}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="格式" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind Format}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource MetricTileLabelStyle}" Text="酒馆助手" />
                            <TextBlock Style="{StaticResource MetricTileValueStyle}" Text="{x:Bind HelperLabel}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsRepeater ItemTemplate="{StaticResource InfoCellTemplate}" ItemsSource="{x:Bind InfoCells}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="56"
                            MinItemWidth="140"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubSectionTitleTextStyle}" Text="提示词结构" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipTextStyle}"
                            Text="{x:Bind HintLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Prompts}" ItemTemplate="{StaticResource PromptItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="PageShell" Padding="32,24,32,28" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  窄窗：列表收窄、页边距收紧，把宽度让给详情  -->
                        <Setter Target="ListColumn.Width" Value="300" />
                        <Setter Target="PageShell.Padding" Value="24,20,24,20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ==================== 页头 ====================  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="资源管理" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="角色卡、世界书、对话记录与预设都躺在实例的数据目录里；左侧挑选，右侧看清内容，再决定去留。" />
            </StackPanel>

            <StackPanel
                x:Name="HeaderActions"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <Border Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock
                            x:Name="HeaderSummaryText"
                            Style="{StaticResource StatusPillTextStyle}"
                            Text="共 21 个资源" />
                    </StackPanel>
                </Border>
                <Button
                    x:Name="ImportButton"
                    Click="Import_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8B5;" />
                        <TextBlock x:Name="ImportButtonText" Text="导入角色卡" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  操作反馈：收起时行高归零，不占位  -->
            <InfoBar
                x:Name="ActionInfoBar"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />
        </Grid>

        <!--  ==================== 数据目录 ====================  -->
        <Border
            Grid.Row="1"
            Padding="18,12"
            Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    Background="#1F2B88D8"
                    CornerRadius="8">
                    <FontIcon
                        FontSize="17"
                        Foreground="#FF2B88D8"
                        Glyph="&#xE8B7;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="数据目录" />
                        <Border Style="{StaticResource MetaChipStyle}">
                            <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="内置 · v1.19.2" />
                        </Border>
                        <Border Style="{StaticResource MetaChipStyle}">
                            <TextBlock
                                x:Name="TabFolderChip"
                                FontFamily="Consolas"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="characters" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="DataPathText"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="C:\Users\al01\AppData\Roaming\AstraBrew Launcher\sillytavern\data\default-user\characters"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    x:Name="DataActions"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button Click="CopyPath_Click" ToolTipService.ToolTip="复制完整路径">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            <TextBlock Text="复制路径" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenDirectory_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                            <TextBlock Text="打开目录" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==================== 分类 Tab ====================  -->
        <Border
            Grid.Row="2"
            Padding="4"
            Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                    x:Name="TabCharacters"
                    Checked="Tab_Checked"
                    GroupName="ResourceTabs"
                    Style="{StaticResource TabStripRadioStyle}"
                    Tag="characters">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="14" Glyph="&#xE77B;" />
                        <TextBlock Text="角色卡" />
                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MetaChipStyle}">
                            <TextBlock
                                x:Name="CountCharacters"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="0" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    x:Name="TabWorldBooks"
                    Checked="Tab_Checked"
                    GroupName="ResourceTabs"
                    Style="{StaticResource TabStripRadioStyle}"
                    Tag="worldbooks">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                        <TextBlock Text="世界书" />
                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MetaChipStyle}">
                            <TextBlock
                                x:Name="CountWorldBooks"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="0" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    x:Name="TabChats"
                    Checked="Tab_Checked"
                    GroupName="ResourceTabs"
                    Style="{StaticResource TabStripRadioStyle}"
                    Tag="chats">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                        <TextBlock Text="对话" />
                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MetaChipStyle}">
                            <TextBlock
                                x:Name="CountChats"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="0" />
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    x:Name="TabPresets"
                    Checked="Tab_Checked"
                    GroupName="ResourceTabs"
                    Style="{StaticResource TabStripRadioStyle}"
                    Tag="presets">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="14" Glyph="&#xE9E9;" />
                        <TextBlock Text="预设" />
                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MetaChipStyle}">
                            <TextBlock
                                x:Name="CountPresets"
                                Style="{StaticResource MetaChipTextStyle}"
                                Text="0" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!--  ==================== 列表 + 详情 ====================  -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：当前分类的资源列表  -->
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  卡头  -->
                    <Grid Padding="18,14,18,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="ListIconTile"
                            Width="38"
                            Height="38"
                            VerticalAlignment="Center"
                            Background="#1F2B88D8"
                            CornerRadius="8">
                            <FontIcon
                                x:Name="ListIconGlyph"
                                FontSize="16"
                                Foreground="#FF2B88D8"
                                Glyph="&#xE77B;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="ListTitleText"
                                Style="{StaticResource CellTitleTextStyle}"
                                Text="角色卡" />
                            <TextBlock
                                x:Name="ListSummaryText"
                                Style="{StaticResource FieldHintTextStyle}"
                                Text="共 6 个 · 16.2 MB" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="重新扫描资源目录"
                            Click="Rescan_Click"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="重新扫描资源目录">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <!--  搜索  -->
                    <Grid Grid.Row="1" Padding="18,0,18,12">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            PlaceholderText="搜索名称、作者或标签…"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <Rectangle
                        Grid.Row="2"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  列表：卡片内缩 8 + 行内边距 10 = 与卡头同为 18 的内容线  -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="ResourceList"
                            Margin="8,8,8,8"
                            ItemsSource="{x:Bind Rows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:ResourceRow">
                                    <Grid>

                                        <!--  对话列表里的角色分组头  -->
                                        <Border
                                            Margin="0,8,0,2"
                                            Padding="10,6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind GroupVisibility}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Glyph="&#xE77B;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MetaChipTextStyle}"
                                                    Text="{x:Bind Meta}" />
                                            </Grid>
                                        </Border>

                                        <!--  资源行  -->
                                        <Button
                                            Click="Row_Click"
                                            Style="{StaticResource ListRowButtonStyle}"
                                            Visibility="{x:Bind ItemVisibility}">
                                            <Grid>
                                                <Border
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="6"
                                                    Opacity="0.10"
                                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                                <Border
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Opacity="0.45"
                                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                                                <Grid Padding="10,9" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  角色卡：书封式缩略（占位为名称首字）  -->
                                                    <Border
                                                        Width="44"
                                                        Height="58"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind CoverBackground}"
                                                        CornerRadius="5"
                                                        Visibility="{x:Bind CoverVisibility}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="17"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind CoverForeground}"
                                                            Text="{x:Bind Monogram}" />
                                                    </Border>

                                                    <!--  其余三类：色相图标座  -->
                                                    <Border
                                                        Width="34"
                                                        Height="34"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind TileBackground}"
                                                        CornerRadius="8"
                                                        Visibility="{x:Bind IconVisibility}">
                                                        <FontIcon
                                                            FontSize="15"
                                                            Foreground="{x:Bind TileForeground}"
                                                            Glyph="{x:Bind Glyph}" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock
                                                            Style="{StaticResource CellTitleTextStyle}"
                                                            Text="{x:Bind Title}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Subtitle}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{x:Bind Meta}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <FontIcon
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Glyph="&#xE76C;"
                                                        Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  空态：搜索结果为空或该分类没有资源  -->
                    <StackPanel
                        x:Name="ListEmptyPanel"
                        Grid.Row="3"
                        Margin="24,0,24,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Border
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="10">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8F1;" />
                        </Border>
                        <TextBlock
                            x:Name="ListEmptyTitleText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource CardTitleTextStyle}"
                            Text="没有匹配的资源" />
                        <TextBlock
                            x:Name="ListEmptyHintText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FieldHintTextStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="换个关键词，或清空搜索框后重试。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  卡底：排序说明  -->
                    <Border
                        Grid.Row="4"
                        Padding="18,8,18,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            x:Name="ListFootText"
                            Style="{StaticResource FieldHintTextStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="按最近修改排序 · 直接读目录，不需要手动登记" />
                    </Border>
                </Grid>
            </Border>

            <!--  右侧：选中资源的详情  -->
            <Border
                Grid.Column="1"
                Padding="0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  卡头：资源名 + 文件信息 + 动作  -->
                    <Grid Padding="18,14,18,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="DetailIconTile"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon
                                x:Name="DetailIconGlyph"
                                FontSize="17"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8F1;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="DetailTitleText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="选择左侧的资源"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="DetailSubText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="文件名、体积与修改时间会显示在这里"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            x:Name="DetailActions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button x:Name="WorkbenchButton" Click="OpenWorkbench_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                    <TextBlock Text="打开工作台" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="删除这个资源"
                                Click="Delete_Click"
                                Style="{StaticResource DangerIconButtonStyle}"
                                ToolTipService.ToolTip="删除这个资源">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!--  详情正文：四类资源共用一个宿主，切换时换模板  -->
                    <ScrollViewer
                        x:Name="DetailScroll"
                        Grid.Row="2"
                        Padding="18,16,18,18"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto">
                        <ContentControl
                            x:Name="DetailBody"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top" />
                    </ScrollViewer>

                    <!--  未选中 / 该分类没有资源  -->
                    <StackPanel
                        x:Name="DetailEmptyPanel"
                        Grid.Row="2"
                        Margin="24,0,24,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="9">
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <FontIcon
                                x:Name="DetailEmptyGlyph"
                                FontSize="21"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE77B;" />
                        </Border>
                        <TextBlock
                            x:Name="DetailEmptyTitleText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SectionTitleTextStyle}"
                            FontSize="15"
                            Text="还没有选中资源" />
                        <TextBlock
                            x:Name="DetailEmptyHintText"
                            MaxWidth="320"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FieldHintTextStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="从左侧列表挑一个，这里会展开它的完整信息。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
