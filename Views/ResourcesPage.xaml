<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="资源管理" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="集中管理角色卡、世界书、预设与本地模型等资源文件。" />
            </StackPanel>

            <!--  分类概览  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="角色卡" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="48" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="26.4 MB" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="世界书" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="16" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="8.2 MB" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="预设" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="9" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="412 KB" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="本地模型" />
                        <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="3" />
                        <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="9.6 GB" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  资源列表  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="资源文件" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                MinWidth="130"
                                SelectedIndex="0">
                                <ComboBoxItem Content="全部类型" />
                                <ComboBoxItem Content="角色卡" />
                                <ComboBoxItem Content="世界书" />
                                <ComboBoxItem Content="预设" />
                                <ComboBoxItem Content="本地模型" />
                            </ComboBox>
                            <Button Content="导入资源" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="打开目录" />
                        </StackPanel>
                    </Grid>

                    <Rectangle
                        Height="1"
                        Margin="0,12"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="星野澪.png" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="角色卡 · 含内嵌世界书" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="2026-10-18" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="2.1 MB" />
                        <Button
                            Grid.Column="3"
                            Content="移除" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="赛博都市.json" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="世界书 · 128 条条目" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="2026-10-15" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="684 KB" />
                        <Button
                            Grid.Column="3"
                            Content="移除" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="长上下文预设.json" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="预设 · 12 个提示词条目" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="2026-09-30" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="46 KB" />
                        <Button
                            Grid.Column="3"
                            Content="移除" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CellTitleTextStyle}" Text="qwen2.5-7b-instruct.Q4_K_M.gguf" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="本地模型 · 可离线运行" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CardBodyTextStyle}"
                            Text="2026-09-12" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="4.4 GB" />
                        <Button
                            Grid.Column="3"
                            Content="移除" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
