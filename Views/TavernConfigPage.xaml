<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.TavernConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="酒馆配置" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="修改服务监听、启动行为与数据目录设置，保存后需重启服务生效。" />
            </StackPanel>

            <!--  服务设置  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="服务设置" />

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="监听地址" />
                        <ComboBox
                            Grid.Column="1"
                            Width="260"
                            HorizontalAlignment="Left"
                            SelectedIndex="0">
                            <ComboBoxItem Content="127.0.0.1（仅本机）" />
                            <ComboBoxItem Content="0.0.0.0（局域网可访问）" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="端口" />
                        <NumberBox
                            Grid.Column="1"
                            Width="260"
                            HorizontalAlignment="Left"
                            Minimum="1024"
                            Maximum="65535"
                            SpinButtonPlacementMode="Compact"
                            Value="8000" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="启动时自动拉起服务" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsOn="True" OffContent="" OnContent="" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="启动参数" />
                        <TextBox
                            Grid.Column="1"
                            FontFamily="Consolas"
                            PlaceholderText="--config config.yaml"
                            HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  数据目录  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="数据目录" />

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="安装目录" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="%AppData%\AstraBrew Launcher\lib\tavern" />
                        <Button
                            Grid.Column="2"
                            Content="浏览…" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="用户数据目录" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoTextStyle}"
                            Text="%AppData%\AstraBrew Launcher\data" />
                        <Button
                            Grid.Column="2"
                            Content="浏览…" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="自动备份" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                            <ToggleSwitch IsOn="True" OffContent="" OnContent="" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardBodyTextStyle}"
                                Text="每次启动服务前备份一次数据" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存配置" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="重置为默认" />
                <Button Content="打开配置文件" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
