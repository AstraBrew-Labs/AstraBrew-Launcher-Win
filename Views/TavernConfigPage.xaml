                                        Grid.Row="1"
                                        Content="启用服务器插件"
                                        ToolTipService.ToolTip="启用服务器插件。对应 enableServerPlugins。" />
                                    <CheckBox x:Name="Field_enableServerPluginsAutoUpdate"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="插件自动更新" ToolTipService.ToolTip="启动时自动更新服务器插件。对应 enableServerPluginsAutoUpdate。"
                                        IsChecked="True" />
                                    <CheckBox x:Name="Field_sso__autheliaAuth"
                                        Grid.Row="2"
                                        Content="Authelia 单点登录"
                                        ToolTipService.ToolTip="在反向代理上装好 Authelia 后再开：用同名账号（小写）自动登录。对应 sso.autheliaAuth。" />
                                    <CheckBox x:Name="Field_sso__authentikAuth" Grid.Row="2" Grid.Column="1" Content="Authentik 单点登录" ToolTipService.ToolTip="在反向代理上装好 Authentik 后再开：用同名账号（小写）自动登录。对应 sso.authentikAuth。" />
                                    <CheckBox x:Name="Field_cacheBuster__enabled"
                                        Grid.Row="3"
                                        Content="启用缓存破坏"
                                        ToolTipService.ToolTip="首次加载或上传图片后清除浏览器缓存；需要 localhost 或 HTTPS 域名才生效。对应 cacheBuster.enabled。" />
                                    <CheckBox x:Name="Field_enableCorsProxy" Grid.Row="3" Grid.Column="1" Content="启用 CORS 代理" ToolTipService.ToolTip="启用 CORS 代理中间件。对应 enableCorsProxy。" />
                                    <CheckBox x:Name="Field_enableDownloadableTokenizers"
                                        Grid.Row="4"
                                        Content="允许下载分词器"
                                        ToolTipService.ToolTip="按需下载额外的模型分词器；关闭时回退到本机已有的分词器。对应 enableDownloadableTokenizers。" />
                                    <CheckBox x:Name="Field_disableCsrfProtection"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Content="禁用 CSRF 校验"
                                        ToolTipService.ToolTip="关闭 CSRF 防护，官方标注「不推荐」。对应 disableCsrfProtection。" />
                                    <CheckBox x:Name="Field_skipContentCheck"
                                        Grid.Row="5"
                                        Content="跳过内容检查"
                                        ToolTipService.ToolTip="跳过新默认内容的检查。对应 skipContentCheck。" />
                                    <CheckBox x:Name="Field_allowKeysExposure"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Content="允许导出密钥"
                                        ToolTipService.ToolTip="允许通过 API 导出密钥。对应 allowKeysExposure。" />
                                </Grid>
                            </Border>

                            <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                <CheckBox x:Name="Field_securityOverride"
                                    Content="忽略启动安全检查"
                                    ToolTipService.ToolTip="关闭启动时的安全检查，官方标注「不推荐」。对应 securityOverride。" />
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="缓存破坏规则" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="只对匹配该正则的浏览器 UA 清缓存，例如 firefox|safari（不区分大小写）。对应 cacheBuster.userAgentPattern。" />
                                    </StackPanel>

                                    <TextBox
                                        Grid.Column="1"
                                        x:Name="Field_cacheBuster__userAgentPattern"
                                        AutomationProperties.Name="缓存破坏规则"
                                        FontFamily="Consolas"
                                        PlaceholderText="可选" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  ==================== 底部说明 ====================  -->
            <TextBlock
                x:Name="DirtyHint"
                Style="{StaticResource FootnoteTextStyle}"
                Text="改动会自动保存到 config.yaml，下次启动服务时生效" />

        </StackPanel>
    </ScrollViewer>

        <!--
            首次使用遮罩：全局配置与默认配置都不存在时盖住整页。
            用户点一次「获取默认配置」就好，不用自己去找 config.yaml 该放哪。
        -->
        <Border
            x:Name="ConfigMask"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="520"
                Padding="28,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">

                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="30"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8B7;" />

                    <StackPanel Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="还没有酒馆配置文件" />
                        <TextBlock
                            Style="{StaticResource FieldHintTextStyle}"
                            Text="首次使用需要先准备一份配置。启动器会下载 SillyTavern 官方默认配置，并顺手调好：端口 11451、开启 IPv6、允许局域网访问、白名单只保留本机。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Padding="12,10" Style="{StaticResource SubPanelStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="配置将保存到" />
                            <TextBlock
                                x:Name="MaskPathText"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="FetchConfigBtn"
                        HorizontalAlignment="Center"
                        Click="FetchConfig_Click"
                        Style="{StaticResource AccentActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE896;" />
                            <TextBlock Text="获取默认配置" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        x:Name="FetchProgress"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="MaskStatusText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldHintTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
