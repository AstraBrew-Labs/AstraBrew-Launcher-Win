<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.TavernConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="using:AstraBrew_Launcher.Views.Controls"
    xmlns:services="using:AstraBrew_Launcher.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            IP 白名单的标签。IP / 网段都很短，一行横着能放五六个，
            竖列表纯属浪费横向空间——这里用换行面板铺开，多了才在卡片内滚动。
        -->
        <DataTemplate x:Key="WhitelistTagTemplate" x:DataType="services:WhitelistEntry">
            <Grid>
                <!--  锁定项：中性底 + 小锁，没有叉  -->
                <Border Style="{StaticResource LockedTagChipStyle}" Visibility="{x:Bind LockVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Value}" />
                    </StackPanel>
                </Border>

                <!--  自定义项：强调色淡底 + 小叉  -->
                <Border Style="{StaticResource WhitelistEditChipStyle}" Visibility="{x:Bind DeleteVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind Value}" />
                        <Button
                            Width="18"
                            Height="18"
                            AutomationProperties.Name="移除该项"
                            Click="RemoveWhitelist_Click"
                            Style="{StaticResource ChipCloseButtonStyle}"
                            ToolTipService.ToolTip="从白名单移除">
                            <FontIcon FontSize="9" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <!--  ==================== 页头 ====================  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="酒馆配置" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="调整端口、访问范围与启动行为，修改在下次启动服务时生效。" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">

                    <!--  保存状态：改动会自动落盘，这里只表示「有没有还没写进去的」  -->
                    <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="StateDotClean"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <Ellipse
                                    x:Name="StateDotDirty"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="StateText" Style="{StaticResource StatusPillTextStyle}" Text="已同步" />
                        </StackPanel>
                    </Border>

                    <Button AutomationProperties.Name="打开配置文件" Click="OpenConfigFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                            <TextBlock Text="打开配置文件" />
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.Name="导入配置" Click="ImportConfig_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8B5;" />
                            <TextBlock Text="导入配置" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ResetBtn"
                        AutomationProperties.Name="恢复默认配置"
                        Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE777;" />
                            <TextBlock Text="恢复默认" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ==================== 版本切换 ====================  -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SegmentTrackStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <RadioButton
                                x:Name="SimpleRadio"
                                AutomationProperties.Name="小白版"
                                Checked="Version_Checked"
                                GroupName="ConfigVersion"
                                IsChecked="True"
                                Style="{StaticResource SegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                                    <TextBlock Text="小白版" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="AdvancedRadio"
                                AutomationProperties.Name="高手版"
                                Checked="Version_Checked"
                                GroupName="ConfigVersion"
                                Style="{StaticResource SegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE943;" />
                                    <TextBlock Text="高手版" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionTitle" Style="{StaticResource CellTitleTextStyle}" Text="小白版 · 常用设置" />
                            <TextBlock
                                x:Name="VersionHint"
                                Style="{StaticResource FieldHintTextStyle}"
                                Text="只放最常用的几项，其余按官方推荐值跑就好。" />
                        </StackPanel>

                        <TextBlock
                            x:Name="VersionCount"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FootnoteTextStyle}"
                            Text="5 项" />
                    </Grid>
                </Grid>
            </Border>

            <!--
                ==================== 小白版 ====================
                只保留会直接影响「能不能连上、用什么打开」的选项。
            -->
            <StackPanel x:Name="SimplePanel" Spacing="16">

                <!--  常用设置  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Padding="18,15,18,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#1A2B88D8" Style="{StaticResource SectionIconTileStyle}">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FF2B88D8"
                                    Symbol="Setting" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource CellTitleTextStyle}"
                                    Text="常用设置" />
                                <TextBlock
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Text="改完自动保存，下次启动酒馆时生效。" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="14" Spacing="8">

                            <!--  端口  -->
                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="端口" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="手机、平板访问酒馆时用的门牌号，一般不用改。" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <NumberBox
                                            x:Name="SimplePortBox"
                                            Width="150"
                                            AutomationProperties.Name="端口"
                                            LargeChange="100"
                                            Maximum="65535"
                                            Minimum="1024"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            ValueChanged="Port_ValueChanged" />
                                        <TextBlock
                                            x:Name="SimplePortError"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource FieldHintTextStyle}"
                                            Text="端口需在 1024–65535 之间"
                                            TextWrapping="NoWrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  局域网访问  -->
                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="局域网访问" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="打开后，同一个 Wi-Fi 下的手机、平板也能打开酒馆。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="SimpleLanToggle"
                                        Grid.Column="1"
                                        AutomationProperties.Name="局域网访问"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="Lan_Toggled" />
                                </Grid>
                            </Border>

                            <!--  自动打开浏览器（仅普通模式）  -->
                            <Border x:Name="SimpleAutoBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="自动打开浏览器" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启动后自动帮你打开酒馆页面，不用手动点。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="SimpleAutoBrowserToggle"
                                        Grid.Column="1"
                                        AutomationProperties.Name="自动打开浏览器"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="AutoBrowser_Toggled" />
                                </Grid>
                            </Border>

                            <!--  默认浏览器（仅普通模式）  -->
                            <Border x:Name="SimpleBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="默认浏览器" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="自动打开时用哪个浏览器；和首页的快捷切换是同一个设置。" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="SimpleBrowserCombo"
                                        Grid.Column="1"
                                        Width="180"
                                        AutomationProperties.Name="默认浏览器"
                                        SelectionChanged="Browser_SelectionChanged">
                                        <ComboBoxItem Content="谷歌浏览器" />
                                        <ComboBoxItem Content="Edge" />
                                        <ComboBoxItem Content="火狐浏览器" />
                                        <ComboBoxItem Content="系统默认" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  IP 白名单  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Padding="18,15,18,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#1A16A34A" Style="{StaticResource SectionIconTileStyle}">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FF16A34A"
                                    Symbol="List" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource CellTitleTextStyle}"
                                    Text="IP 白名单" />
                                <TextBlock
                                    Style="{StaticResource FieldHintTextStyle}"
                                    x:Name="SimpleWhitelistSubtitle"
                                    Text="只有名单里的地址能连上酒馆；127.0.0.1 与 ::1 固定保留。" />
                            </StackPanel>

                            <TextBlock
                                x:Name="SimpleWhitelistCount"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource FootnoteTextStyle}"
                                Text="3 条" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="14" Spacing="8">
                            <!--  条目多时在卡片内滚动：全铺出来会把整页拉成一条竖线  -->
                            <ScrollViewer
                                x:Name="SimpleWhitelistScroll"
                                MaxHeight="150"
                                Padding="0,0,4,0"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    x:Name="SimpleWhitelistList"
                                    ItemTemplate="{StaticResource WhitelistTagTemplate}"
                                    ItemsSource="{x:Bind Whitelist}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid x:Name="SimpleWhitelistInputRow" ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="SimpleWhitelistInput"
                                    AutomationProperties.Name="新增白名单地址"
                                    Height="32"
                                    KeyDown="WhitelistInput_KeyDown"
                                    PlaceholderText="输入 IP 或网段，回车即可添加" />

                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="添加白名单"
                                    Click="AddWhitelistSimple_Click"
                                    Content="添加"
                                    Style="{StaticResource AccentActionButtonStyle}" />
                            </Grid>

                            <TextBlock
                                x:Name="SimpleWhitelistError"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource FieldHintTextStyle}"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="SimpleWhitelistNote"
                                Style="{StaticResource FieldHintTextStyle}"
                                Text="只有名单里的地址能连上酒馆；127.0.0.1 与 ::1 固定保留，其余可以增删。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                ==================== 高手版 ====================
                与旧版一致的 9 组配置，全部选项保留；分组可折叠，避免一屏塞满。
            -->
            <StackPanel
                x:Name="AdvancedPanel"
                Spacing="12"
                Visibility="Collapsed">

                <!--  ========== 1. 网络与访问 ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="NetHeader"
                            AutomationProperties.Name="网络与访问"
                            IsChecked="True"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Net"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A2B88D8" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FF2B88D8"
                                        Symbol="Globe" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        Text="网络与访问" />
                                    <TextBlock
                                        x:Name="NetworkSectionHint"
                                        Style="{StaticResource FieldHintTextStyle}"
                                        Text="端口、监听地址、协议栈与默认浏览器" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="NetChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70E;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="NetBody"
                            Padding="14,0,14,14"
                            Spacing="8">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="端口" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="服务监听端口。对应 port，可用范围 1024–65535。" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <NumberBox
                                            x:Name="AdvPortBox"
                                            Width="150"
                                            AutomationProperties.Name="端口"
                                            LargeChange="100"
                                            Maximum="65535"
                                            Minimum="1024"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            ValueChanged="Port_ValueChanged" />
                                        <TextBlock
                                            x:Name="AdvPortError"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource FieldHintTextStyle}"
                                            Text="端口需在 1024–65535 之间"
                                            TextWrapping="NoWrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="监听地址" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="监听的具体地址，支持 IPv4 与 IPv6。对应 listenAddress.ipv4 与 listenAddress.ipv6，默认监听所有网卡。" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="ListenIpv4Box"
                                            AutomationProperties.Name="IPv4 监听地址"
                                            Header="IPv4"
                                            PlaceholderText="0.0.0.0"
                                            Text="0.0.0.0"
                                            TextChanged="ListenAddress_Changed" />

                                        <TextBox
                                            x:Name="ListenIpv6Box"
                                            Grid.Column="1"
                                            AutomationProperties.Name="IPv6 监听地址"
                                            Header="IPv6"
                                            PlaceholderText="[::]"
                                            Text="[::]"
                                            TextChanged="ListenAddress_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                <Grid ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="Field_protocol__ipv4" Content="启用 IPv4" ToolTipService.ToolTip="至少要启用一个协议：IPv4 / IPv6。对应 protocol.ipv4。" IsChecked="True" />
                                    <CheckBox x:Name="Field_protocol__ipv6" Grid.Column="1" Content="启用 IPv6" ToolTipService.ToolTip="至少要启用一个协议；auto 会按系统是否支持自动检测。对应 protocol.ipv6。" />
                                    <CheckBox
                                        x:Name="Field_dnsPreferIPv6"
                                        Grid.Row="1"
                                        Content="DNS 优先 IPv6"
                                        ToolTipService.ToolTip="解析域名时优先用 IPv6；运营商 IPv6 有问题时别开。对应 dnsPreferIPv6。" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="心跳间隔" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="秒；写心跳文件的间隔，0 表示关闭。对应 heartbeatInterval。" />
                                    </StackPanel>

                                    <NumberBox
                                        x:Name="HeartbeatBox"
                                        Grid.Column="1"
                                        Width="150"
                                        AutomationProperties.Name="心跳间隔"
                                        LargeChange="1000"
                                        Minimum="0"
                                        SmallChange="500"
                                        SpinButtonPlacementMode="Compact"
                                        Value="0"
                                        ValueChanged="Heartbeat_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border x:Name="AdvAutoBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="自动打开浏览器" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="酒馆启动时自动打开浏览器。对应 browserLaunch.enabled。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="AdvAutoBrowserToggle"
                                        Grid.Column="1"
                                        AutomationProperties.Name="自动打开浏览器"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="AutoBrowser_Toggled" />
                                </Grid>
                            </Border>

                            <Border x:Name="AdvBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="默认浏览器" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="用哪个浏览器打开。对应 browserLaunch.browser：default / firefox / chrome / edge，Android 不支持。" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="AdvBrowserCombo"
                                        Grid.Column="1"
                                        Width="180"
                                        AutomationProperties.Name="默认浏览器"
                                        SelectionChanged="Browser_SelectionChanged">
                                        <ComboBoxItem Content="谷歌浏览器" />
                                        <ComboBoxItem Content="Edge" />
                                        <ComboBoxItem Content="火狐浏览器" />
                                        <ComboBoxItem Content="系统默认" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ========== 2. 账号与访问控制 ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="AuthHeader"
                            AutomationProperties.Name="账号与访问控制"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Auth"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A7C3AED" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FF7C3AED"
                                        Symbol="Contact" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        Text="账号与访问控制" />
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="基础认证、用户账号、白名单与 Host 校验" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="AuthChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="AuthBody"
                            Padding="14,0,14,14"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="基础认证" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="为接口开启基础认证，打开酒馆时要输用户名和密码。对应 basicAuthMode。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="Field_basicAuthMode"
                                        Grid.Column="1"
                                        AutomationProperties.Name="基础认证"
                                        OffContent=""
                                        OnContent=""
                                        Tag="AuthPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel
                                x:Name="AuthPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldTitleTextStyle}"
                                            Text="用户名" />
                                        <TextBox
                                            x:Name="Field_basicAuthUser__username"
                                            Grid.Column="1"
                                            AutomationProperties.Name="认证用户名"
                                            Text="user" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldTitleTextStyle}"
                                            Text="密码" />
                                        <PasswordBox
                                            x:Name="Field_basicAuthUser__password"
                                            Grid.Column="1"
                                            AutomationProperties.Name="认证密码"
                                            Password="password" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                <Grid ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="Field_enableUserAccounts" Content="启用用户账号" ToolTipService.ToolTip="多用户模式，每人各自登录。对应 enableUserAccounts。" />
                                    <CheckBox x:Name="Field_enableDiscreetLogin" Grid.Column="1" Content="隐蔽登录" ToolTipService.ToolTip="登录页不显示用户列表，只能手动输用户名。对应 enableDiscreetLogin。" />
                                    <CheckBox
                                        x:Name="Field_perUserBasicAuth"
                                        Grid.Row="1"
                                        Content="每用户独立认证"
                                        ToolTipService.ToolTip="与基础认证同时开启时，认证用的用户名密码与各自账号一致。对应 perUserBasicAuth。" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="IP 白名单" />
                                        <TextBlock
                                            x:Name="AdvWhitelistSubtitle"
                                            Style="{StaticResource FieldHintTextStyle}"
                                            Text="开启后只有名单内的地址能连接，对应 whitelistMode。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="Field_whitelistMode"
                                        Grid.Column="1"
                                        AutomationProperties.Name="IP 白名单"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Tag="WhitelistPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel
                                x:Name="WhitelistPanel"
                                Spacing="8">
                                <ScrollViewer
                                    x:Name="AdvWhitelistScroll"
                                    MaxHeight="150"
                                    Padding="0,0,4,0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        x:Name="AdvWhitelistList"
                                        ItemTemplate="{StaticResource WhitelistTagTemplate}"
                                        ItemsSource="{x:Bind Whitelist}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid x:Name="AdvWhitelistInputRow" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="AdvWhitelistInput"
                                        AutomationProperties.Name="新增白名单地址"
                                        Height="32"
                                        KeyDown="WhitelistInput_KeyDown"
                                        PlaceholderText="输入 IP 或网段，回车即可添加" />

                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="添加白名单"
                                        Click="AddWhitelistAdvanced_Click"
                                        Content="添加" />
                                </Grid>

                                <TextBlock
                                    x:Name="AdvWhitelistError"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    x:Name="AdvWhitelistNote"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Text="只有名单里的地址能连上酒馆；127.0.0.1 与 ::1 固定保留，其余可以增删。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="Host 白名单" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="校验请求头里的 Host，防止域名伪装；建议在开启监听（局域网访问）时使用。对应 hostWhitelist.enabled。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="Field_hostWhitelist__enabled"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Host 白名单"
                                        OffContent=""
                                        OnContent=""
                                        Tag="HostPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel
                                x:Name="HostPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                    <CheckBox
                                        x:Name="Field_hostWhitelist__scan"
                                        Content="扫描 Host 头自动补充"
                                        IsChecked="True"
                                        ToolTipService.ToolTip="扫描收到的请求，识别疑似 Host 头伪装。对应 hostWhitelist.scan。" />
                                </Border>

                                <TextBox
                                    x:Name="FieldArray_hostWhitelist__hosts"
                                    AcceptsReturn="True"
                                    AutomationProperties.Name="Host 白名单列表"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Height="76"
                                    PlaceholderText="每行一个域名"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <StackPanel Spacing="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="导入域名" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="从这些域名导入角色卡时，信任它们提供的图片地址。对应 whitelistImportDomains。" />
                                    </StackPanel>

                                    <TextBox
                                        x:Name="FieldArray_whitelistImportDomains"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="导入域名列表"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Height="76"
                                        PlaceholderText="每行一个域名，例如 example.com"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ========== 3. HTTPS / SSL ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="SslHeader"
                            AutomationProperties.Name="HTTPS / SSL"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Ssl"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A16A34A" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FF16A34A"
                                        Symbol="ProtectedDocument" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        Text="HTTPS / SSL" />
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启用加密传输，配置证书与私钥路径" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="SslChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="SslBody"
                            Padding="14,0,14,14"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="启用 HTTPS" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启用 SSL/TLS 加密；必须同时提供证书与私钥，否则服务起不来。对应 ssl.enabled。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="Field_ssl__enabled"
                                        Grid.Column="1"
                                        AutomationProperties.Name="启用 HTTPS"
                                        OffContent=""
                                        OnContent=""
                                        Tag="SslPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel
                                x:Name="SslPanel"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldTitleTextStyle}"
                                            Text="证书路径" />
                                        <TextBox
                                            x:Name="Field_ssl__certPath"
                                            Grid.Column="1"
                                            AutomationProperties.Name="证书路径"
                                            FontFamily="Consolas"
                                            Text="./certs/cert.pem" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldTitleTextStyle}"
                                            Text="私钥路径" />
                                        <TextBox
                                            x:Name="Field_ssl__keyPath"
                                            Grid.Column="1"
                                            AutomationProperties.Name="私钥路径"
                                            FontFamily="Consolas"
                                            Text="./certs/privkey.pem" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="私钥口令" />
                                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="私钥口令，私钥没有加密就留空。对应 ssl.keyPassphrase；更安全的做法是用命令行参数或环境变量传入。" />
                                        </StackPanel>
                                        <PasswordBox
                                            x:Name="Field_ssl__keyPassphrase"
                                            Grid.Column="1"
                                            AutomationProperties.Name="私钥口令"
                                            PlaceholderText="可选" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ========== 4. 跨域 CORS ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="CorsHeader"
                            AutomationProperties.Name="跨域 CORS"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Cors"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A0E9AA7" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FF0E9AA7"
                                        Symbol="Link" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        Text="跨域 CORS" />
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="允许来源、方法与请求头，按需收紧" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="CorsChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="CorsBody"
                            Padding="14,0,14,14"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="启用 CORS" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="启用或关闭 CORS 中间件；关掉后跨域请求会被浏览器直接拦下。对应 cors.enabled。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        x:Name="Field_cors__enabled"
                                        AutomationProperties.Name="启用 CORS"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Tag="CorsPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="CorsPanel" Spacing="8">
                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="允许来源" />
                                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="允许的来源：null 表示浏览器直接打开本地文件，* 表示允许任意来源。对应 cors.origin，每行一个。" />
                                        </StackPanel>
                                        <TextBox
                                            AcceptsReturn="True"
                                            x:Name="FieldArray_cors__origin"
                                            AutomationProperties.Name="CORS 允许来源"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Height="64"
                                            Text="null"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="允许方法" />
                                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="允许的 HTTP 方法。对应 cors.methods，每行一个。" />
                                        </StackPanel>
                                        <TextBox
                                            AcceptsReturn="True"
                                            x:Name="FieldArray_cors__methods"
                                            AutomationProperties.Name="CORS 允许方法"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Height="64"
                                            Text="OPTIONS"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="预检缓存时间" />
                                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="预检请求的缓存时间（秒），留空表示不发送缓存头。对应 cors.maxAge。" />
                                        </StackPanel>

                                        <NumberBox
                                            Grid.Column="1"
                                            Width="150"
                                            x:Name="Field_cors__maxAge"
                                            AutomationProperties.Name="预检缓存时间"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Compact"
                                            PlaceholderText="未设置" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="允许请求头" />
                                        <TextBox
                                            AcceptsReturn="True"
                                            x:Name="FieldArray_cors__allowedHeaders"
                                            AutomationProperties.Name="CORS 允许请求头"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Height="56"
                                            PlaceholderText="每行一个，留空表示不限制"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingRowCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="暴露响应头" />
                                        <TextBox
                                            AcceptsReturn="True"
                                            x:Name="FieldArray_cors__exposedHeaders"
                                            AutomationProperties.Name="CORS 暴露响应头"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Height="56"
                                            PlaceholderText="每行一个"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                    <CheckBox
                                        x:Name="Field_cors__credentials" Content="允许携带凭据"
                                        ToolTipService.ToolTip="允许携带 Cookie 与 Authorization 头；开启后来源不能用 *。对应 cors.credentials。" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ========== 5. 代理与备份 ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="ProxyHeader"
                            AutomationProperties.Name="代理与备份"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Proxy"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1AEA580C" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FFEA580C"
                                        Symbol="Save" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        Text="代理与备份" />
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="请求代理、备份份数与聊天记录保护" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="ProxyChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="ProxyBody"
                            Padding="14,0,14,14"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="请求代理" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="开启后，所有出站的 HTTP/HTTPS 请求都走这个代理。对应 requestProxy.enabled。" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        Grid.Column="1"
                                        x:Name="Field_requestProxy__enabled"
                                        AutomationProperties.Name="请求代理"
                                        OffContent=""
                                        OnContent=""
                                        Tag="ProxyPanel"
                                        Toggled="Conditional_Toggled" />
                                </Grid>
                            </Border>

                            <StackPanel
                                x:Name="ProxyPanel"
                                Spacing="8"
                                Visibility="Collapsed">
