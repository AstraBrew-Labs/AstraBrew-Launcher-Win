<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.TavernConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="using:AstraBrew_Launcher.Views.Controls"
    xmlns:services="using:AstraBrew_Launcher.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            IP 白名单的标签。IP / 网段都很短，一行横着能放五六个，
            竖列表纯属浪费横向空间——这里用换行面板铺开，多了才在卡片内滚动。
        -->
        <DataTemplate x:Key="WhitelistTagTemplate" x:DataType="services:WhitelistEntry">
            <Grid>
                <!--  锁定项：中性底 + 小锁，没有叉  -->
                <Border Style="{StaticResource LockedTagChipStyle}" Visibility="{x:Bind LockVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Value}" />
                    </StackPanel>
                </Border>

                <!--  自定义项：强调色淡底 + 小叉  -->
                <Border Style="{StaticResource WhitelistEditChipStyle}" Visibility="{x:Bind DeleteVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind Value}" />
                        <Button
                            Width="18"
                            Height="18"
                            panels:Loc.Name="Cfg.Remove.Name"
                            Click="RemoveWhitelist_Click"
                            Style="{StaticResource ChipCloseButtonStyle}"
                            panels:Loc.ToolTip="Cfg.Remove.Tip">
                            <FontIcon FontSize="9" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <!--  ==================== 页头 ====================  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" panels:Loc.Text="Cfg.Page.Title" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleTextStyle}"
                        panels:Loc.Text="Cfg.Page.Subtitle" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">

                    <!--  保存状态：改动会自动落盘，这里只表示「有没有还没写进去的」  -->
                    <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="StateDotClean"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <Ellipse
                                    x:Name="StateDotDirty"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="StateText" Style="{StaticResource StatusPillTextStyle}" panels:Loc.Text="Cfg.State.Synced" />
                        </StackPanel>
                    </Border>

                    <Button panels:Loc.Name="Cfg.Action.OpenFile" Click="OpenConfigFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                            <TextBlock panels:Loc.Text="Cfg.Action.OpenFile" />
                        </StackPanel>
                    </Button>

                    <Button panels:Loc.Name="Cfg.Action.Import" Click="ImportConfig_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8B5;" />
                            <TextBlock panels:Loc.Text="Cfg.Action.Import" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ResetBtn"
                        panels:Loc.Name="Cfg.Action.Reset.Name"
                        Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE777;" />
                            <TextBlock panels:Loc.Text="Cfg.Action.ResetLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ==================== 版本切换 ====================  -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SegmentTrackStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <RadioButton
                                x:Name="SimpleRadio"
                                panels:Loc.Name="Cfg.Version.SimpleLabel"
                                Checked="Version_Checked"
                                GroupName="ConfigVersion"
                                IsChecked="True"
                                Style="{StaticResource SegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                                    <TextBlock panels:Loc.Text="Cfg.Version.SimpleLabel" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="AdvancedRadio"
                                panels:Loc.Name="Cfg.Version.AdvancedLabel"
                                Checked="Version_Checked"
                                GroupName="ConfigVersion"
                                Style="{StaticResource SegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE943;" />
                                    <TextBlock panels:Loc.Text="Cfg.Version.AdvancedLabel" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionTitle" Style="{StaticResource CellTitleTextStyle}" panels:Loc.Text="Cfg.Version.Simple.Title" />
                            <TextBlock
                                x:Name="VersionHint"
                                Style="{StaticResource FieldHintTextStyle}"
                                panels:Loc.Text="Cfg.Version.Simple.Hint" />
                        </StackPanel>

                        <TextBlock
                            x:Name="VersionCount"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FootnoteTextStyle}"
                            panels:Loc.Text="Cfg.Version.Count" />
                    </Grid>
                </Grid>
            </Border>

            <!--
                ==================== 小白版 ====================
                只保留会直接影响「能不能连上、用什么打开」的选项。
            -->
            <StackPanel x:Name="SimplePanel" Spacing="16">

                <!--  常用设置  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Padding="18,15,18,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#1A2B88D8" Style="{StaticResource SectionIconTileStyle}">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FF2B88D8"
                                    Symbol="Setting" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource CellTitleTextStyle}"
                                    panels:Loc.Text="Cfg.Simple.Section.Title" />
                                <TextBlock
                                    Style="{StaticResource FieldHintTextStyle}"
                                    panels:Loc.Text="Cfg.Simple.Section.Hint" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="14" Spacing="8">

                            <!--  端口  -->
                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.Simple.Port.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.Simple.Port.Hint" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <NumberBox
                                            x:Name="SimplePortBox"
                                            Width="150"
                                            panels:Loc.Name="Cfg.Simple.Port.Title"
                                            LargeChange="100"
                                            Maximum="65535"
                                            Minimum="1024"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            ValueChanged="Port_ValueChanged" />
                                        <TextBlock
                                            x:Name="SimplePortError"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource FieldHintTextStyle}"
                                            panels:Loc.Text="Cfg.Port.Range"
                                            TextWrapping="NoWrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  局域网访问  -->
                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.Simple.Lan.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.Simple.Lan.Hint" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="SimpleLanToggle"
                                        Grid.Column="1"
                                        panels:Loc.Name="Cfg.Simple.Lan.Title"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="Lan_Toggled" />
                                </Grid>
                            </Border>

                            <!--  自动打开浏览器（仅普通模式）  -->
                            <Border x:Name="SimpleAutoBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.Simple.AutoOpen.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.Simple.AutoOpen.Hint" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="SimpleAutoBrowserToggle"
                                        Grid.Column="1"
                                        panels:Loc.Name="Cfg.Simple.AutoOpen.Title"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="AutoBrowser_Toggled" />
                                </Grid>
                            </Border>

                            <!--  默认浏览器（仅普通模式）  -->
                            <Border x:Name="SimpleBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.Simple.Browser.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.Simple.Browser.Hint" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="SimpleBrowserCombo"
                                        Grid.Column="1"
                                        Width="180"
                                        panels:Loc.Name="Cfg.Simple.Browser.Title"
                                        SelectionChanged="Browser_SelectionChanged">
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.Chrome" />
                                        <ComboBoxItem Content="Edge" />
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.Firefox" />
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.System" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  IP 白名单  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Padding="18,15,18,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#1A16A34A" Style="{StaticResource SectionIconTileStyle}">
                                <SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#FF16A34A"
                                    Symbol="List" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource CellTitleTextStyle}"
                                    panels:Loc.Text="Cfg.Simple.Whitelist.Title" />
                                <TextBlock
                                    Style="{StaticResource FieldHintTextStyle}"
                                    x:Name="SimpleWhitelistSubtitle"
                                    panels:Loc.Text="Cfg.Simple.Whitelist.Hint" />
                            </StackPanel>

                            <TextBlock
                                x:Name="SimpleWhitelistCount"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource FootnoteTextStyle}"
                                panels:Loc.Text="Cfg.Whitelist.Count" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="14" Spacing="8">
                            <!--  条目多时在卡片内滚动：全铺出来会把整页拉成一条竖线  -->
                            <ScrollViewer
                                x:Name="SimpleWhitelistScroll"
                                MaxHeight="150"
                                Padding="0,0,4,0"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    x:Name="SimpleWhitelistList"
                                    ItemTemplate="{StaticResource WhitelistTagTemplate}"
                                    ItemsSource="{x:Bind Whitelist}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid x:Name="SimpleWhitelistInputRow" ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="SimpleWhitelistInput"
                                    panels:Loc.Name="Cfg.Whitelist.Add.Name"
                                    Height="32"
                                    KeyDown="WhitelistInput_KeyDown"
                                    panels:Loc.Placeholder="Cfg.Whitelist.Add.Placeholder" />

                                <Button
                                    Grid.Column="1"
                                    panels:Loc.Name="Cfg.Whitelist.Add.ButtonName"
                                    Click="AddWhitelistSimple_Click"
                                    panels:Loc.Content="Cfg.Whitelist.Add.Button"
                                    Style="{StaticResource AccentActionButtonStyle}" />
                            </Grid>

                            <TextBlock
                                x:Name="SimpleWhitelistError"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource FieldHintTextStyle}"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="SimpleWhitelistNote"
                                Style="{StaticResource FieldHintTextStyle}"
                                panels:Loc.Text="Cfg.Whitelist.Note.Editable"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--
                ==================== 高手版 ====================
                与旧版一致的 9 组配置，全部选项保留；分组可折叠，避免一屏塞满。
            -->
            <StackPanel
                x:Name="AdvancedPanel"
                Spacing="12"
                Visibility="Collapsed">

                <!--  ========== 1. 网络与访问 ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="NetHeader"
                            panels:Loc.Name="Cfg.G1.Title"
                            IsChecked="True"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Net"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A2B88D8" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#FF2B88D8"
                                        Symbol="Globe" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        Style="{StaticResource CellTitleTextStyle}"
                                        panels:Loc.Text="Cfg.G1.Title" />
                                    <TextBlock
                                        x:Name="NetworkSectionHint"
                                        Style="{StaticResource FieldHintTextStyle}"
                                        panels:Loc.Text="Cfg.G1.HintLabel" />
                                </StackPanel>

                                <FontIcon
                                    x:Name="NetChevron"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70E;" />
                            </Grid>
                        </ToggleButton>

                        <StackPanel
                            x:Name="NetBody"
                            Padding="14,0,14,14"
                            Spacing="8">
                            <Rectangle
                                Height="1"
                                Margin="0,0,0,6"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G1.Port.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G1.Port.Hint" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <NumberBox
                                            x:Name="AdvPortBox"
                                            Width="150"
                                            panels:Loc.Name="Cfg.G1.Port.Title"
                                            LargeChange="100"
                                            Maximum="65535"
                                            Minimum="1024"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValidationMode="InvalidInputOverwritten"
                                            ValueChanged="Port_ValueChanged" />
                                        <TextBlock
                                            x:Name="AdvPortError"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource FieldHintTextStyle}"
                                            panels:Loc.Text="Cfg.Port.Range"
                                            TextWrapping="NoWrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G1.Listen.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G1.Listen.Hint" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="ListenIpv4Box"
                                            panels:Loc.Name="Cfg.G1.V4.Name"
                                            Header="IPv4"
                                            PlaceholderText="0.0.0.0"
                                            Text="0.0.0.0"
                                            TextChanged="ListenAddress_Changed" />

                                        <TextBox
                                            x:Name="ListenIpv6Box"
                                            Grid.Column="1"
                                            panels:Loc.Name="Cfg.G1.V6.Name"
                                            Header="IPv6"
                                            PlaceholderText="[::]"
                                            Text="[::]"
                                            TextChanged="ListenAddress_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="14,12" Style="{StaticResource SubPanelStyle}">
                                <Grid ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="Field_protocol__ipv4" panels:Loc.Content="Cfg.G1.Proto4Label" panels:Loc.ToolTip="Cfg.G1.Proto4.Tip" IsChecked="True" />
                                    <CheckBox x:Name="Field_protocol__ipv6" Grid.Column="1" panels:Loc.Content="Cfg.G1.Proto6Label" panels:Loc.ToolTip="Cfg.G1.Proto6.Tip" />
                                    <CheckBox
                                        x:Name="Field_dnsPreferIPv6"
                                        Grid.Row="1"
                                        panels:Loc.Content="Cfg.G1.DnsPreferV6Label"
                                        panels:Loc.ToolTip="Cfg.G1.DnsPreferV6.Tip" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G1.Heartbeat.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G1.Heartbeat.Hint" />
                                    </StackPanel>

                                    <NumberBox
                                        x:Name="HeartbeatBox"
                                        Grid.Column="1"
                                        Width="150"
                                        panels:Loc.Name="Cfg.G1.Heartbeat.Title"
                                        LargeChange="1000"
                                        Minimum="0"
                                        SmallChange="500"
                                        SpinButtonPlacementMode="Compact"
                                        Value="0"
                                        ValueChanged="Heartbeat_ValueChanged" />
                                </Grid>
                            </Border>

                            <Border x:Name="AdvAutoBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G1.AutoOpen.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G1.AutoOpen.Hint" />
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="AdvAutoBrowserToggle"
                                        Grid.Column="1"
                                        panels:Loc.Name="Cfg.G1.AutoOpen.Title"
                                        IsOn="True"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="AutoBrowser_Toggled" />
                                </Grid>
                            </Border>

                            <Border x:Name="AdvBrowserRow" Style="{StaticResource SettingRowCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G1.Browser.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G1.Browser.Hint" />
                                    </StackPanel>

                                    <ComboBox
                                        x:Name="AdvBrowserCombo"
                                        Grid.Column="1"
                                        Width="180"
                                        panels:Loc.Name="Cfg.G1.Browser.Title"
                                        SelectionChanged="Browser_SelectionChanged">
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.Chrome" />
                                        <ComboBoxItem Content="Edge" />
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.Firefox" />
                                        <ComboBoxItem panels:Loc.Content="Cfg.Browser.System" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ========== 2. 账号与访问控制 ==========  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="AuthHeader"
                            panels:Loc.Name="Cfg.G2.Title"
                            Style="{StaticResource SectionHeaderToggleStyle}"
                            Tag="Auth"
                            Checked="Section_Toggled"
                            Unchecked="Section_Toggled">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#1A7C3AED" Style="{StaticResource SectionIconTileStyle}">
                                    <SymbolIcon
