                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldTitleTextStyle}" panels:Loc.Text="Cfg.G9.CacheBusterRule.Title" />
                                        <TextBlock Style="{StaticResource FieldHintTextStyle}" panels:Loc.Text="Cfg.G9.CacheBusterRule.Hint" />
                                    </StackPanel>

                                    <TextBox
                                        Grid.Column="1"
                                        x:Name="Field_cacheBuster__userAgentPattern"
                                        panels:Loc.Name="Cfg.G9.CacheBusterRule.Title"
                                        FontFamily="Consolas"
                                        panels:Loc.Placeholder="Cfg.Optional.Placeholder" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  ==================== 底部说明 ====================  -->
            <TextBlock
                x:Name="DirtyHint"
                Style="{StaticResource FootnoteTextStyle}"
                panels:Loc.Text="Cfg.Footer" />

        </StackPanel>
    </ScrollViewer>

        <!--
            首次使用遮罩：全局配置与默认配置都不存在时盖住整页。
            用户点一次「获取默认配置」就好，不用自己去找 config.yaml 该放哪。
        -->
        <Border
            x:Name="ConfigMask"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="520"
                Padding="28,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">

                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="30"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE8B7;" />

                    <StackPanel Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            panels:Loc.Text="Cfg.Empty.Title" />
                        <TextBlock
                            Style="{StaticResource FieldHintTextStyle}"
                            panels:Loc.Text="Cfg.Empty.Body"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Padding="12,10" Style="{StaticResource SubPanelStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource MetaChipTextStyle}" panels:Loc.Text="Cfg.Empty.Path" />
                            <TextBlock
                                x:Name="MaskPathText"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="FetchConfigBtn"
                        HorizontalAlignment="Center"
                        Click="FetchConfig_Click"
                        Style="{StaticResource AccentActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE896;" />
                            <TextBlock panels:Loc.Text="Cfg.Empty.Action" />
                        </StackPanel>
                    </Button>

                    <ProgressRing
                        x:Name="FetchProgress"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="MaskStatusText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldHintTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
