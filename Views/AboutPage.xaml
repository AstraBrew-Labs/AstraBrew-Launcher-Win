<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="关于" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="版本信息、项目链接与开源许可。" />
            </StackPanel>

            <!--  应用信息  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="10">
                            <!--  横版标识：随主题切换深色/浅色两版  -->
                            <Image
                                Height="44"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="星酿启动器 AstraBrew Launcher"
                                Source="{ThemeResource BrandLockupSource}"
                                Stretch="Uniform" />
                            <TextBlock Style="{StaticResource CardBodyTextStyle}" Text="星酿酒馆 SiliconTavern 桌面启动器" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Padding="9,3,9,4"
                            VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="v1.0.0 · x64" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查更新" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="项目主页" />
                        <Button Content="反馈问题" />
                        <Button Content="打开日志目录" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  运行环境  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="0">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource CardTitleTextStyle}"
                        Text="运行环境" />

                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="框架" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="WinUI 3 · .NET 8" />
                    </Grid>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="酒馆内核" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="SiliconTavern v1.4.2" />
                    </Grid>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="安装位置" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="%AppData%\AstraBrew Launcher" />
                    </Grid>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="配置文件" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="%AppData%\AstraBrew Launcher\settings.json" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  许可  -->
            <Expander HorizontalAlignment="Stretch" Header="开源许可与第三方组件">
                <StackPanel Padding="0,8,0,0" Spacing="6">
                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="Windows App SDK — MIT License" />
                    <TextBlock Style="{StaticResource MonoTextStyle}" Text=".NET Runtime — MIT License" />
                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="SiliconTavern — AGPL-3.0 License" />
                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="Segoe Fluent Icons — Microsoft 资产许可" />
                </StackPanel>
            </Expander>

            <TextBlock
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Style="{StaticResource CardBodyTextStyle}"
                Text="© 2026 AstraBrew Labs. 保留所有权利。" />

        </StackPanel>
    </ScrollViewer>
</Page>
