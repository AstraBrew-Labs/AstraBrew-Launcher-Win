<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  分组标题：17 / SemiBold，与卡片里的 13 号行标题拉开两级  -->
        <Style x:Key="SectionHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  行间分隔线  -->
        <Style x:Key="RowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--  链接行之间的分隔线：左右内缩，跟内缩后的悬停块同一套边距  -->
        <Style
            x:Key="LinkRowDividerStyle"
            TargetType="Rectangle"
            BasedOn="{StaticResource RowDividerStyle}">
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!--  信息行：左右内缩 16 与卡片内容对齐，行高由 Padding 撑开  -->
        <Style x:Key="InfoRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  版本号、构建号、路径这类要「对得齐」的值用等宽字  -->
        <Style x:Key="MonoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="PathValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoValueStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--  Hero 动作按钮：比标准 32 略高一档，和整卡的留白比例更配  -->
        <Style x:Key="HeroActionStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="13" />
            <!--  圆角与页面卡片（8）对齐，不用框架默认的 4——4 在 34 高的按钮上接近直角  -->
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--
            链接行：整行可点，hover 时铺一层 subtle 底，不描边。
            圆角 8 + 左右内缩 8，让悬停块浮在卡片里而不是贴死卡片边缘；
            分割线同步内缩到 16（LinkRowDividerStyle），与内容左边缘对齐。
        -->
        <Style x:Key="LinkRowStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="LinkBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LinkBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LinkBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  许可清单行  -->
        <Style x:Key="LicenseRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="880" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Hero：版本胶囊落到品牌标识下方  -->
                        <Setter Target="HeroBadges.(Grid.Row)" Value="1" />
                        <Setter Target="HeroBadges.(Grid.Column)" Value="0" />
                        <Setter Target="HeroBadges.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeroBadges.Margin" Value="0,14,0,0" />

                        <!--  窄窗收窄左右留白  -->
                        <Setter Target="PageRoot.Padding" Value="20,20,20,32" />
                        <Setter Target="LastCheckText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" Style="{StaticResource PageRootStyle}">

                <!--  ==================== 页头 ====================  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" controls:Loc.Text="About.Page.Title" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" controls:Loc.Text="About.Page.Subtitle" />
                </StackPanel>

                <!--  ==================== 品牌主卡 ====================  -->
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid>
                        <!--  卡片底色  -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" />

                        <!--  品牌光晕：与仪表盘服务主卡同一颗「星酿」琥珀光  -->
                        <Border CornerRadius="8" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush
                                    Center="0.1,0"
                                    GradientOrigin="0.1,0"
                                    MappingMode="RelativeToBoundingBox"
                                    RadiusX="0.9"
                                    RadiusY="1">
                                    <GradientStop Color="#2EF0B23E" Offset="0" />
                                    <GradientStop Color="#12F0B23E" Offset="0.55" />
                                    <GradientStop Color="#00F0B23E" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Padding="24,20,24,18" Spacing="0">
                            <Grid ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="10">
                                    <!--  横版标识：随主题切换深色/浅色两版  -->
                                    <!--
                                        横版标识是图片，图里带着中文「星酿启动器」——英文界面下换成纯文字，
                                        中文仍用图（拉丁字母版的品牌图没有现成资产，别硬拉伸中文图）。
                                    -->
                                    <Image
                                        x:Name="HeroBrandImage"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        controls:Loc.Name="Shell.AppName.Full"
                                        Source="{ThemeResource BrandLockupSource}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="HeroBrandText"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed"
                                        controls:Loc.Name="Shell.AppName.Full" />
                                    <TextBlock
                                        MaxWidth="520"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource CardBodyTextStyle}"
                                        controls:Loc.Text="About.Hero.Tagline" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Spacing="10">
                                    <StackPanel
                                        x:Name="HeroBadges"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <!--
                                            内边距与 MetaChipStyle（7,1,7,2）在纵向保持一致：
                                            这里原本是 2,3，比旁边的「渠道 / 架构」胶囊高 2 px，
                                            三枚摆一排看着就是一高一低。
                                        -->
                                        <Border
                                            Padding="8,1,8,2"
                                            Background="#1F2B88D8"
                                            CornerRadius="10"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="HeroVersionChipText"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#FF2B88D8" />
                                        </Border>
                                        <!--  渠道标记：预览版 / 测试版 / 开发版；正式版是「稳定通道」  -->
                                        <Border x:Name="ChannelChip" Style="{StaticResource MetaChipStyle}">
                                            <TextBlock x:Name="ChannelChipText" Style="{StaticResource MetaChipTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock x:Name="ArchChipText" Style="{StaticResource MetaChipTextStyle}" Text="x64" /></Border>
                                    </StackPanel>

                                    <!--
                                        更新渠道：跟哪条发布线走。胶囊下面是这块「标签 + 下拉」，
                                        与右上角的状态标记同列右对齐。

                                        上面那 15 的顶边距不是随手写的：左列是「40 高的标识 + 10 间距 + 一行简介」，
                                        简介的中心比胶囊行低约 30 DIP，这里补一段让**下拉与左侧简介同一水平线**——
                                        视觉上两栏才是齐的。改左列标识高度或间距时，这个值要跟着改。

                                        注意它和上面那枚「开发版」胶囊是两个概念：那枚是「这个 exe 由哪条线编出来」，
                                        这里选的是「更新时看哪条线的发布」。
                                    -->
                                    <StackPanel
                                        x:Name="UpdateChannelPanel"
                                        Margin="0,15,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FootnoteTextStyle}"
                                            controls:Loc.Text="About.Channel.Label" />
                                        <ComboBox
                                            x:Name="UpdateChannelSelect"
                                            MinWidth="128"
                                            FontSize="12"
                                            SelectionChanged="UpdateChannel_SelectionChanged">
                                            <ComboBoxItem controls:Loc.Content="About.Channel.Option.Auto" />
                                            <ComboBoxItem controls:Loc.Content="About.Channel.Option.0" />
                                            <ComboBoxItem controls:Loc.Content="About.Channel.Option.1" />
                                            <ComboBoxItem controls:Loc.Content="About.Channel.Option.2" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Rectangle
                                Height="1"
                                Margin="0,18,0,14"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="CheckUpdateButton"
                                            Click="CheckUpdate_Click"
                                            Style="{StaticResource AccentActionButtonStyle}"
                                            MinHeight="34"
                                            Padding="14,4"
                                            CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                <!--
                                                    这两处文案（按钮文字、右侧状态）是**状态驱动**的，
                                                    不能挂 Loc.Text：Loc 在首帧会把文本重置回资源值，
                                                    把「正在下载 42%」「有新版本 vX」这种实时状态直接盖掉。
                                                    初值由 ApplyUpdateState() 在构造函数里给，换语言时它也会重跑。
                                                -->
                                                <TextBlock x:Name="CheckUpdateText" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Click="OpenLink_Click"
                                            controls:Loc.Content="About.Link.Home"
                                            Style="{StaticResource HeroActionStyle}"
                                            Tag="https://launcher.astrabrew.cn" />
                                        <Button
                                            Click="OpenLink_Click"
                                            controls:Loc.Content="About.Link.Issues"
                                            Style="{StaticResource HeroActionStyle}"
                                            Tag="mailto:support@astrabrew.cn" />
                                    </StackPanel>

                                <TextBlock
                                    x:Name="LastCheckText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FootnoteTextStyle}" />
                            </Grid>

                            <!--
                                更新日志：只有「真的检测到新版本」时才出现，内容取自 Release 的简介
                                （也就是发布时写的那段 Markdown），整理规则见 Services/ReleaseNotes.cs。

                                不折叠、不加「展开」按钮：点完检查更新最想看的就是这个，
                                再让他多点一次是多余的。高度给上限，长了自己滚。
                            -->
                            <StackPanel
                                x:Name="ReleaseNotesPanel"
                                Margin="0,12,0,0"
                                Spacing="6"
                                Visibility="Collapsed">
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock
                                    x:Name="ReleaseNotesTitle"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <ScrollViewer
                                    MaxHeight="150"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="ReleaseNotesText"
                                        FontSize="12"
                                        LineHeight="19"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ==================== 版本与构建 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1F2B88D8" Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF2B88D8" Glyph="&#xE946;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="About.Group.Version.Title" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" controls:Loc.Text="About.Group.Version.Hint" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Current" />
                                <TextBlock
                                    x:Name="VersionValue"
                                    Grid.Column="1"
                                    Style="{StaticResource MonoValueStyle}" />
                                <Border
                                    x:Name="VersionBadge"
                                    Grid.Column="2"
                                    Padding="8,1,8,2"
                                    Background="#1F16A34A"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="VersionBadgeText"
                                        FontSize="10"
                                        Foreground="#FF16A34A" />
                                </Border>
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Build" />
                                <TextBlock
                                    x:Name="BuildValue"
                                    Grid.Column="1"
                                    Style="{StaticResource MonoValueStyle}" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.ProductLine" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource InfoValueStyle}"
                                    controls:Loc.Text="About.ProductLine.Value" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 运行环境 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1F16A34A" Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF16A34A" Glyph="&#xE964;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="About.Group.Runtime.Title" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" controls:Loc.Text="About.Group.Runtime.Hint" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Framework" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="WinUI 3 · Windows App SDK 2.5.1" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.DotNet" />
                                <TextBlock
                                    x:Name="RuntimeValue"
                                    Grid.Column="1"
                                    Style="{StaticResource MonoValueStyle}" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Graphics" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource InfoValueStyle}"
                                    controls:Loc.Text="About.Graphics.Value" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Os" />
                                <TextBlock
                                    x:Name="OsValue"
                                    Grid.Column="1"
                                    Style="{StaticResource InfoValueStyle}" />
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Arch" />
                                <TextBlock
                                    x:Name="ArchValue"
                                    Grid.Column="1"
                                    Style="{StaticResource InfoValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 安装位置 ====================  -->
                <StackPanel Spacing="11">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1F0E9AA7" Style="{StaticResource SectionIconTileStyle}">
                            <FontIcon FontSize="17" Foreground="#FF0E9AA7" Glyph="&#xED25;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SectionHeaderTitleStyle}" controls:Loc.Text="About.Group.Paths.Title" />
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" controls:Loc.Text="About.Group.Paths.Hint" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Program" />
                                <TextBlock
                                    x:Name="AppDirValue"
                                    Grid.Column="1"
                                    Style="{StaticResource PathValueStyle}" />
                                <Button
                                    Grid.Column="2"
                                    Click="OpenFolder_Click"
                                    CornerRadius="8"
                                    controls:Loc.ToolTip="About.Action.Open.ToolTip"
                                    Tag="app">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                        <TextBlock FontSize="13" controls:Loc.Text="About.Action.Open.Label" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource InfoLabelStyle}" controls:Loc.Text="About.Field.Data" />
                                <TextBlock
                                    x:Name="DataDirValue"
                                    Grid.Column="1"
                                    Style="{StaticResource PathValueStyle}" />
                                <Button
                                    Grid.Column="2"
                                    Click="OpenFolder_Click"
                                    CornerRadius="8"
                                    controls:Loc.ToolTip="About.Action.Open.ToolTip"
                                    Tag="data">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                        <TextBlock FontSize="13" controls:Loc.Text="About.Action.Open.Label" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Rectangle Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
