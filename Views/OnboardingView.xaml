<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AstraBrew_Launcher.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:onboarding="using:AstraBrew_Launcher.Views.Onboarding"
    mc:Ignorable="d">

    <!--  遮罩：盖住内容区（含导航栏），标题栏保持可用  -->
    <Grid x:Name="Root" Background="{ThemeResource OnboardingScrimBrush}">
        <Border
            Width="840"
            Height="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ==================== 左轨：时间轴 ====================  -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8,0,0,8">
                    <Grid Padding="20,24,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image
                                Height="24"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="星酿启动器"
                                Source="{ThemeResource BrandIconSource}"
                                Stretch="Uniform" />
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="AstraBrew" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="第一次用" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,28,0,0"
                            Spacing="0">
                            <onboarding:OnboardingRailItem
                                x:Name="Rail1"
                                Number="1"
                                Subtitle="可跳过"
                                Title="搬数据" />
                            <onboarding:OnboardingRailItem
                                x:Name="Rail2"
                                Number="2"
                                Subtitle="要能通"
                                Title="测网络" />
                            <onboarding:OnboardingRailItem
                                x:Name="Rail3"
                                Number="3"
                                Subtitle="要装齐"
                                Title="装工具" />
                            <onboarding:OnboardingRailItem
                                x:Name="Rail4"
                                Number="4"
                                IsLast="True"
                                Subtitle="最后一步"
                                Title="选酒馆" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            LineHeight="16"
                            MaxLines="2"
                            Text="每步都能跳过，之后在设置里能重看。"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!--  ==================== 右栏：内容 ====================  -->
                <Grid
                    Grid.Column="1"
                    Padding="24,24,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题区固定 89（眉标 16 + 标题 27 + 说明两行 40），切步时不抖  -->
                    <StackPanel MinHeight="89" Spacing="0">
                        <TextBlock
                            x:Name="StepEyebrow"
                            Style="{StaticResource OnboardingStepEyebrowTextStyle}"
                            Text="第 1 步，共 4 步" />
                        <TextBlock
                            x:Name="StepTitle"
                            Margin="0,2,0,0"
                            Style="{StaticResource OnboardingStepTitleTextStyle}"
                            Text="把旧数据搬过来" />
                        <TextBlock
                            x:Name="StepDescription"
                            Margin="0,4,0,0"
                            Style="{StaticResource OnboardingStepDescTextStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <onboarding:OnboardingStep1Migration x:Name="Step1" />
                            <onboarding:OnboardingStep2Network x:Name="Step2" Visibility="Collapsed" />
                            <onboarding:OnboardingStep3Runtime x:Name="Step3" Visibility="Collapsed" />
                            <onboarding:OnboardingStep4Instance x:Name="Step4" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <!--  底部操作  -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Rectangle
                            Height="1"
                            Margin="0,0,0,12"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Grid.Row="1">
                            <Button
                                x:Name="SkipButton"
                                HorizontalAlignment="Left"
                                Click="Skip_Click"
                                Content="先跳过"
                                Style="{StaticResource GhostButtonStyle}" />

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="BackButton"
                                    Click="Back_Click"
                                    Content="上一步"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="NextButton"
                                    Click="Next_Click"
                                    Content="下一步"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentActionButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
