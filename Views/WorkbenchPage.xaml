<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AstraBrew_Launcher.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AstraBrew_Launcher.Views"
    xmlns:panels="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  ==================== 可编辑标签 ====================  -->

        <DataTemplate x:Key="EditTagTemplate" x:DataType="views:EditTag">
            <Border Style="{StaticResource EditTagChipStyle}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind Text}" />
                    <Button
                        Click="TagRemove_Click"
                        Style="{StaticResource ChipCloseButtonStyle}"
 panels:Loc.ToolTip="Wb.Tag.Remove.Tip">
                        <FontIcon FontSize="8" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  ==================== 内嵌世界书条目（只读行） ====================  -->

        <DataTemplate x:Key="EmbeddedEntryTemplate" x:DataType="views:EntryForm">
            <Border
                Margin="5,0,5,10"
                Padding="10,8,10,8"
                Style="{StaticResource SubPanelStyle}">
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ShortIndex}" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Comment}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind KeysLabel}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        Style="{StaticResource StatePillStyle}"
                        Visibility="{x:Bind EnabledVisibility}">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource StatePillTextStyle}"
 panels:Loc.Text="Wb.Entry.On" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatePillStyle}"
                        Visibility="{x:Bind DisabledVisibility}">
                        <TextBlock Style="{StaticResource StatePillTextStyle}" panels:Loc.Text="Wb.Entry.Off" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  ==================== 世界书条目编辑器 ====================  -->

        <DataTemplate x:Key="EntryCardTemplate" x:DataType="views:EntryForm">
            <Border
                Margin="5"
                Padding="0"
                Style="{StaticResource SubPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="12,6,8,6"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontFamily="Consolas"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ShortIndex}" />

                        <!--  标题一行、正文预览一行：收起时也能看清是哪条  -->
                        <Button
                            Grid.Column="1"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToggleEntry_Click"
 panels:Loc.ToolTip="Wb.Entry.Toggle.Tip">
                            <StackPanel Spacing="1">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind Comment}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind SummaryLine, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipStyle}"
                            Visibility="{x:Bind KeyHintVisibility}">
                            <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="{x:Bind KeyHint}" />
                        </Border>

                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Entry.On" />
                            <ToggleSwitch
                                MinWidth="0"
                                IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <Button
                            Grid.Column="4"
                            Width="26"
                            Height="26"
                            Padding="0"
 panels:Loc.Name="Wb.Entry.Toggle.Name"
                            Click="ToggleEntry_Click"
                            Style="{StaticResource SubtleIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Entry.Toggle.Tip">
                            <FontIcon FontSize="10" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                        </Button>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}" />

                    <StackPanel
                        Grid.Row="2"
                        Padding="12,10,12,12"
                        Spacing="9"
                        Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">

                        <TextBox
                            FontSize="12"
 panels:Loc.Placeholder="Wb.Entry.Comment.Placeholder"
                            Text="{x:Bind Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="5">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Keys.Title" />
                                <ItemsControl ItemsSource="{x:Bind Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="EditTagTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        FontSize="12"
                                        KeyDown="KeyInput_KeyDown"
 panels:Loc.Placeholder="Wb.Entry.Keys.Placeholder"
                                        Tag="primary"
                                        Text="{x:Bind KeysInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="AddKey_Click"
                                        Tag="primary"
 panels:Loc.ToolTip="Wb.Entry.Keys.Add.Tip">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Secondary.Title" />
                                <ItemsControl ItemsSource="{x:Bind SecondaryKeys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="EditTagTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        FontSize="12"
                                        KeyDown="KeyInput_KeyDown"
 panels:Loc.Placeholder="Wb.Entry.Keys.Placeholder"
                                        Tag="secondary"
                                        Text="{x:Bind SecondaryKeysInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="AddKey_Click"
                                        Tag="secondary"
 panels:Loc.ToolTip="Wb.Entry.Secondary.Add.Tip">
                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBox
                            Height="96"
 panels:Loc.Placeholder="Wb.Entry.Body.Placeholder"
                            Style="{StaticResource BodyTextBoxStyle}"
                            Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Order.Title" />
                                <TextBox
                                    FontSize="12"
                                    Text="{x:Bind Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Position.Title" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    FontSize="12"
                                    ItemsSource="{x:Bind PositionOptions}"
                                    SelectedIndex="{x:Bind Position, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Probability.Title" />
                                <TextBox
                                    FontSize="12"
                                    Text="{x:Bind Probability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Entry.Depth.Title" />
                                <TextBox
                                    FontSize="12"
                                    Text="{x:Bind Depth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  ==================== 预设提示词编辑器 ====================  -->

        <DataTemplate x:Key="PromptCardTemplate" x:DataType="views:PromptForm">
            <Border
                Margin="5"
                Padding="0"
                Style="{StaticResource SubPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="12,7,8,7"
                        ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaChipStyle}">
                            <TextBlock Style="{StaticResource MetaChipTextStyle}" Text="{x:Bind KindLabel}" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Identifier}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <Border
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                Style="{StaticResource StatePillStyle}"
                                Visibility="{x:Bind EnabledVisibility}">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource StatePillTextStyle}"
 panels:Loc.Text="Wb.Prompt.On" />
                            </Border>
                            <Border
                                Style="{StaticResource StatePillStyle}"
                                Visibility="{x:Bind DisabledVisibility}">
                                <TextBlock Style="{StaticResource StatePillTextStyle}" panels:Loc.Text="Wb.Prompt.Off" />
                            </Border>
                            <Border
                                Style="{StaticResource StatePillStyle}"
                                Visibility="{x:Bind MarkerVisibility}">
                                <TextBlock Style="{StaticResource StatePillTextStyle}" panels:Loc.Text="Wb.Prompt.PlaceholderChip" />
                            </Border>

                            <ToggleSwitch
                                MinWidth="0"
                                IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent=""
                                Visibility="{x:Bind EditorVisibility}" />
                            <Button
                                Width="24"
                                Height="24"
                                Click="DeletePrompt_Click"
                                Style="{StaticResource DangerIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Prompt.Delete.Tip"
                                Visibility="{x:Bind EditorVisibility}">
                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel
                        Grid.Row="2"
                        Padding="12,9,12,11"
                        Spacing="8">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                FontSize="12"
 panels:Loc.Placeholder="Wb.Prompt.Name.Placeholder"
                                Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{x:Bind RoleOptions}"
                                SelectedIndex="{x:Bind Role, Mode=TwoWay}"
                                Visibility="{x:Bind EditorVisibility}" />
                            <Button
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Padding="0"
 panels:Loc.Name="Wb.Prompt.Body.Name"
                                Click="EditPrompt_Click"
                                Style="{StaticResource SubtleIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Prompt.Body.Tip"
                                Visibility="{x:Bind EditorVisibility}">
                                <FontIcon FontSize="12" Glyph="&#xE70F;" />
                            </Button>
                        </Grid>

                        <!--  正文只放预览：每张卡塞一个能装几千字的输入框，光布局就要 40 ms/张  -->
                        <TextBlock
                            MaxLines="4"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Content}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind EditorVisibility}" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Prompt.PlaceholderNote"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind MarkerVisibility}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ==================== 页头：身份 + 保存态 + 动作 ====================  -->
        <Grid
            x:Name="HeaderBar"
            Padding="32,14,32,13"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="11">
                <Button
                    VerticalAlignment="Center"
                    Click="Back_Click"
                    Style="{StaticResource SubtleIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Back.Tip">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>

                <Border
                    x:Name="KindTile"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#1F2B88D8"
                    CornerRadius="8">
                    <FontIcon
                        x:Name="KindGlyph"
                        FontSize="17"
                        Foreground="#FF2B88D8"
                        Glyph="&#xE77B;" />
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="KindTitleText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Title.Character" />
                    <TextBlock
                        x:Name="KindSubText"
                        FontFamily="Consolas"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Subtitle.Reading" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

                <Button
                    x:Name="UndoButton"
                    Click="Undo_Click"
                    IsEnabled="False"
                    Style="{StaticResource SubtleIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Undo.Tip">
                    <FontIcon FontSize="13" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    x:Name="RedoButton"
                    Click="Redo_Click"
                    IsEnabled="False"
                    Style="{StaticResource SubtleIconButtonStyle}"
 panels:Loc.ToolTip="Wb.Redo.Tip">
                    <FontIcon FontSize="13" Glyph="&#xE7A6;" />
                </Button>

                <Grid
                    Width="96"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center">
                    <StackPanel
                        x:Name="SaveStatePanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <ProgressRing
                            x:Name="SaveRing"
                            Width="12"
                            Height="12"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <Ellipse
                            x:Name="SaveDot"
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            x:Name="SaveStateText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
 panels:Loc.Text="Wb.State.Saved" />
                    </StackPanel>
                </Grid>

                <HyperlinkButton
                    x:Name="RetryButton"
                    Padding="4,0"
                    Click="Retry_Click"
                    FontSize="12"
                    Visibility="Collapsed">
                    <TextBlock panels:Loc.Text="Wb.Action.Retry" />
                </HyperlinkButton>

                <Button
                    Click="Done_Click"
 panels:Loc.Content="Wb.Action.Done"
                    Style="{StaticResource AccentActionButtonStyle}" />
            </StackPanel>
        </Grid>

        <Rectangle
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--  ==================== 正文 ====================  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="PageBody"
                Padding="32,14,32,28">

                <!--  ==================== 角色卡 ====================  -->
                <StackPanel x:Name="CharacterView" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ProfileColumn" Width="380" />
                            <ColumnDefinition x:Name="EditorColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  左：资料卡  -->
                        <Border Padding="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Padding="14,12" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="28"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Background="#1F2B88D8"
                                        CornerRadius="6">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="#FF2B88D8"
                                            Glyph="&#xE77B;" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.Section.Profile" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.Section.Hint" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!--  封面  -->
                                <Grid Padding="14,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="104"
                                        Height="146"
                                        Background="{x:Bind Character.CoverBackground}"
                                        CornerRadius="6">
                                        <Grid>
                                            <!--  真卡面：直接读磁盘上的 PNG，缩到 208 宽解码  -->
                                            <Image
                                                Source="{x:Bind Character.CoverSource, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind Character.CoverImageVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="12,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.NoCover"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind Character.CoverEmptyVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="7">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.CoverLabel" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.Cover.Hint"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Padding="9,4,11,5"
                                                Click="ChangeCover_Click"
                                                IsEnabled="{x:Bind Character.CanReplaceCover}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="11" Glyph="&#xEB9F;" />
                                                    <TextBlock FontSize="12" panels:Loc.Text="Wb.Card.Cover.Change" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!--  基本字段  -->
                                <StackPanel Padding="14,12,14,14" Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Card.Name.Title" />
                                        <TextBox
                                            FontSize="12.5"
 panels:Loc.Placeholder="Wb.Card.Name.Placeholder"
                                            Text="{x:Bind Character.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Card.Creator.Title" />
                                            <TextBox
                                                FontSize="12.5"
                                                Text="{x:Bind Character.Creator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.Card.Version.Title" />
                                            <TextBox
                                                FontSize="12.5"
                                                Text="{x:Bind Character.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource MetaCellLabelStyle}"
 panels:Loc.Text="Wb.Card.Tags.Title" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource MetaCellLabelStyle}"
                                                Text="{x:Bind Character.TagSummary, Mode=OneWay}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{x:Bind Character.Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <panels:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <StaticResource ResourceKey="EditTagTemplate" />
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="CharTagInput"
                                                FontSize="12.5"
                                                KeyDown="CharTagInput_KeyDown"
 panels:Loc.Placeholder="Wb.Card.Tags.Placeholder"
                                                Text="{x:Bind Character.TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                Click="AddCharTag_Click"
 panels:Loc.ToolTip="Wb.Card.Tags.Add.Tip">
                                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  右：四段长文本  -->
                        <Grid
                            x:Name="TextGrid"
                            Grid.Column="1"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Height="252"
                                Padding="0"
                                Style="{StaticResource SubPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12,6,8,3" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.DescriptionLabel" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Character.DescriptionCount, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
 panels:Loc.Name="Wb.Card.Description.Expand"
                                            Click="ExpandText_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="description"
 panels:Loc.ToolTip="Wb.Common.Expand.Tip">
                                            <FontIcon FontSize="11" Glyph="&#xE740;" />
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Grid.Row="1"
                                        Padding="12,0,12,10"
 panels:Loc.Placeholder="Wb.Card.Description.Placeholder"
                                        Style="{StaticResource BodyTextBoxStyle}"
                                        Text="{x:Bind Character.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Height="252"
                                Padding="0"
                                Style="{StaticResource SubPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12,6,8,3" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.PersonalityLabel" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Character.PersonalityCount, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
 panels:Loc.Name="Wb.Card.Personality.Expand"
                                            Click="ExpandText_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="personality"
 panels:Loc.ToolTip="Wb.Common.Expand.Tip">
                                            <FontIcon FontSize="11" Glyph="&#xE740;" />
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Grid.Row="1"
                                        Padding="12,0,12,10"
 panels:Loc.Placeholder="Wb.Card.Personality.Placeholder"
                                        Style="{StaticResource BodyTextBoxStyle}"
                                        Text="{x:Bind Character.Personality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Height="252"
                                Padding="0"
                                Style="{StaticResource SubPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12,6,8,3" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.ScenarioLabel" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Character.ScenarioCount, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
 panels:Loc.Name="Wb.Card.Scenario.Expand"
                                            Click="ExpandText_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="scenario"
 panels:Loc.ToolTip="Wb.Common.Expand.Tip">
                                            <FontIcon FontSize="11" Glyph="&#xE740;" />
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Grid.Row="1"
                                        Padding="12,0,12,10"
 panels:Loc.Placeholder="Wb.Card.Scenario.Placeholder"
                                        Style="{StaticResource BodyTextBoxStyle}"
                                        Text="{x:Bind Character.Scenario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Height="252"
                                Padding="0"
                                Style="{StaticResource SubPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12,6,8,3" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
 panels:Loc.Text="Wb.Card.FirstMessageLabel" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Character.FirstMessageCount, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
 panels:Loc.Name="Wb.Card.FirstMessage.Expand"
                                            Click="ExpandText_Click"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Tag="firstMessage"
 panels:Loc.ToolTip="Wb.Common.Expand.Tip">
                                            <FontIcon FontSize="11" Glyph="&#xE740;" />
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Grid.Row="1"
                                        Padding="12,0,12,10"
 panels:Loc.Placeholder="Wb.Card.FirstMessage.Placeholder"
                                        Style="{StaticResource BodyTextBoxStyle}"
                                        Text="{x:Bind Character.FirstMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  内嵌世界书  -->
                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Padding="18,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    Background="#1F8E44DC"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="#FF8E44DC"
                                        Glyph="&#xE8F1;" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CellTitleTextStyle}"
 panels:Loc.Text="Wb.Card.Embedded.Title" />
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock
                                                x:Name="EmbeddedCountChip"
                                                Style="{StaticResource MetaChipTextStyle}"
 />
                                        </Border>
                                        <Border
                                            x:Name="EmbeddedStatePill"
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            Style="{StaticResource StatePillStyle}">
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Style="{StaticResource StatePillTextStyle}"
 panels:Loc.Text="Wb.Card.Embedded.Bound" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="EmbeddedSubText"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.Embedded.Unbound"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button Click="ChangeWorldBook_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE8B7;" />
                                            <TextBlock x:Name="ChangeWorldText" FontSize="12" panels:Loc.Text="Wb.Card.Embedded.Change" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UnbindWorldButton" Click="UnbindWorldBook_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE894;" />
                                            <TextBlock FontSize="12" panels:Loc.Text="Wb.Card.Embedded.Unbind" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid
                                x:Name="EmbeddedEntriesHost"
                                Grid.Row="2"
                                Padding="18,10,18,12">
                                <ItemsControl
                                    x:Name="EmbeddedEntryList"
                                    Margin="-5,0,-5,-10"
                                    ItemsSource="{x:Bind EmbeddedWorld.Entries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:ColumnGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="EmbeddedEntryTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Border
                                x:Name="EmbeddedFoot"
                                Grid.Row="3"
                                Padding="18,7,18,7"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.Embedded.Note" />
                            </Border>

                            <!--  未绑定：只留一句说明与一个绑定入口  -->
                            <StackPanel
                                x:Name="EmbeddedEmpty"
                                Grid.Row="2"
                                Grid.RowSpan="2"
                                Padding="18,20,18,22"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Border
                                    Width="42"
                                    Height="42"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        FontSize="17"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8F1;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CardTitleTextStyle}"
 panels:Loc.Text="Wb.Card.Embedded.Empty.Title" />
                                <TextBlock
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource FieldHintTextStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Card.Embedded.Empty.Hint"
                                    TextAlignment="Center" />
                                <Button
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Click="BindWorldBook_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="11" Glyph="&#xE710;" />
                                        <TextBlock FontSize="12" panels:Loc.Text="Wb.Card.Embedded.Bind" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  ==================== 世界书 ====================  -->
                <StackPanel
                    x:Name="WorldBookView"
                    Spacing="12"
                    Visibility="Collapsed">

                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Padding="18,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    Background="#1F8E44DC"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="#FF8E44DC"
                                        Glyph="&#xE8F1;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource CellTitleTextStyle}"
 panels:Loc.Text="Wb.Title.WorldBook" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.World.Subtitle" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid
                                Padding="18,14,18,16"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.World.Name" />
                                    <TextBox
                                        FontSize="12.5"
                                        Text="{x:Bind WorldBook.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{StaticResource MetaCellLabelStyle}" panels:Loc.Text="Wb.World.Creator" />
                                    <TextBox
                                        FontSize="12.5"
                                        Text="{x:Bind WorldBook.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MetaCellLabelStyle}"
 panels:Loc.Text="Wb.World.Size" />
                                    <Border
                                        Padding="9,5,9,6"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource MetaChipStyle}">
                                        <TextBlock
                                            x:Name="WorldSizeText"
                                            FontFamily="Consolas"
                                            Style="{StaticResource MetaChipTextStyle}"
                                            Text="—" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Padding="18,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    Background="#1F2B88D8"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="#FF2B88D8"
                                        Glyph="&#xE8A5;" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CellTitleTextStyle}"
 panels:Loc.Text="Wb.World.EntriesLabel" />
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock
                                                x:Name="EntryCountChip"
                                                Style="{StaticResource MetaChipTextStyle}"
 />
                                        </Border>
                                        <Border Style="{StaticResource MetaChipStyle}">
                                            <TextBlock
                                                x:Name="EntryEnabledChip"
                                                Style="{StaticResource MetaChipTextStyle}"
 />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.World.Entries.Hint" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button Click="AddEntry_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="11" Glyph="&#xE710;" />
                                            <TextBlock FontSize="12" panels:Loc.Text="Wb.World.Entry.Add" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid Padding="18,5,18,0">
                                <ItemsControl
                                    x:Name="EntryList"
                                    Margin="-5,0,-5,-5"
                                    ItemsSource="{x:Bind VisibleEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <panels:ColumnGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="EntryCardTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!--  条目多时只铺一页：一张展开的条目卡要布局十来个输入框，全铺出来会卡  -->
                            <Border Padding="18,0,18,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="EntryPageText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FieldHintTextStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <StackPanel
                                        x:Name="EntryPagerHost"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ==================== 预设 ====================  -->
                <StackPanel
                    x:Name="PresetView"
                    Spacing="12"
                    Visibility="Collapsed">

                    <Border Padding="18,14" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="38"
                                Height="38"
                                VerticalAlignment="Center"
                                Background="#1FC08A00"
                                CornerRadius="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="#FFC08A00"
                                    Glyph="&#xE9E9;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CellTitleTextStyle}"
 panels:Loc.Text="Wb.Preset.Prompts" />
                                    <Border Style="{StaticResource MetaChipStyle}">
                                        <TextBlock
                                            x:Name="PromptCountChip"
                                            Style="{StaticResource MetaChipTextStyle}"
 />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 panels:Loc.Text="Wb.Preset.Hint" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="AddPrompt_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="&#xE710;" />
                                    <TextBlock FontSize="12" panels:Loc.Text="Wb.Preset.Prompt.Add" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl
                        x:Name="PromptList"
                        Margin="-5"
                        ItemsSource="{x:Bind VisiblePrompts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <panels:ColumnGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PromptCardTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Padding="18,9,18,9" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PresetFootText"
                                VerticalAlignment="Center"
                                Style="{StaticResource FieldHintTextStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
 />
                            <StackPanel
                                x:Name="PagerHost"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  窄窗：收紧页边距，资料栏回到 320  -->
                        <Setter Target="PageBody.Padding" Value="24,12,24,24" />
                        <Setter Target="HeaderBar.Padding" Value="24,12,24,11" />
                        <Setter Target="ProfileColumn.Width" Value="*" />
                        <Setter Target="EditorColumn.Width" Value="0" />
                        <!--  资料卡独占一行，四块文本落到下面横跨整行，避免每块只剩一百多像素  -->
                        <Setter Target="TextGrid.(Grid.Row)" Value="1" />
                        <Setter Target="TextGrid.(Grid.Column)" Value="0" />
                        <Setter Target="TextGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TextGrid.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
