<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AstraBrew_Launcher.Views.Controls.ExtensionInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AstraBrew_Launcher.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title=""
    CloseButtonText=""
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText=""
    mc:Ignorable="d">

    <Grid Width="470">
        <!--  ==================== 表单 ====================  -->
        <StackPanel x:Name="FormPanel" Spacing="14">

            <!--  安装方式：Git / 离线包，两条互斥路径；两段等宽，像分段控件  -->
            <Border Padding="4" Style="{StaticResource SubPanelStyle}">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton
                        x:Name="GitTab"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Checked="Tab_Checked"
                        GroupName="InstallTabs"
                        IsChecked="True"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE774;" />
                            <TextBlock controls:Loc.Text="Eid.Tab.Git" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="OfflineTab"
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Checked="Tab_Checked"
                        GroupName="InstallTabs"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                            <TextBlock controls:Loc.Text="Eid.Tab.Offline" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!--  Git 面板  -->
            <StackPanel x:Name="GitPanel" Spacing="8">
                <TextBlock Style="{StaticResource FieldTitleTextStyle}" controls:Loc.Text="Eid.Field.UrlLabel" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="UrlBox"
                        controls:Loc.Placeholder="Eid.Field.Url.Placeholder"
                        TextChanged="UrlBox_TextChanged" />
                    <Button
                        x:Name="DetectButton"
                        Grid.Column="1"
                        Click="Detect_Click"
                        controls:Loc.Content="Eid.Action.Detect" />
                </Grid>

                <TextBlock Style="{StaticResource FieldTitleTextStyle}" controls:Loc.Text="Eid.Field.Branch" />
                <ComboBox
                    x:Name="BranchBox"
                    HorizontalAlignment="Stretch"
                    controls:Loc.Placeholder="Eid.Branch.Placeholder" />

                <TextBlock
                    Style="{StaticResource FieldHintTextStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    controls:Loc.Text="Eid.Note.Git" />
            </StackPanel>

            <!--  离线面板  -->
            <StackPanel
                x:Name="OfflinePanel"
                Spacing="8"
                Visibility="Collapsed">
                <Button Click="PickOffline_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="12" Glyph="&#xE8E5;" />
                        <TextBlock controls:Loc.Text="Eid.Label.PickOffline" />
                    </StackPanel>
                </Button>

                <!--  已选的包逐个列出预检结果：哪个能装、装成什么名字、哪个有问题  -->
                <Border
                    x:Name="OfflineListPanel"
                    Padding="10,6"
                    Style="{StaticResource SubPanelStyle}"
                    Visibility="Collapsed">
                    <ScrollViewer MaxHeight="148" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OfflineHost" Spacing="2" />
                    </ScrollViewer>
                </Border>

                <TextBlock
                    x:Name="OfflineText"
                    Style="{StaticResource FieldHintTextStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    controls:Loc.Text="Eid.Package.None" />

                <TextBlock
                    Style="{StaticResource FieldHintTextStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    controls:Loc.Text="Eid.Note.Offline" />
            </StackPanel>

            <!--  校验提示放在两条路径之外，切 Tab 后仍然可见  -->
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource FieldHintTextStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  ==================== 安装进度 ====================  -->
        <StackPanel
            x:Name="ProgressPanel"
            Spacing="10"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="#1F2B88D8"
                    CornerRadius="6">
                    <FontIcon
                        FontSize="13"
                        Foreground="#FF2B88D8"
                        Glyph="&#xE72C;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="PhaseText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        controls:Loc.Text="ExtS.Step.Cloning" />
                    <TextBlock
                        x:Name="PhaseHintText"
                        Style="{StaticResource MetaChipTextStyle}"
                        controls:Loc.Text="Eid.Phase.Step1" />
                </StackPanel>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0%" />
            </Grid>

            <ProgressBar
                x:Name="InstallBar"
                Height="4"
                Maximum="100"
                Minimum="0"
                Value="0" />

            <Border Padding="12,10" Style="{StaticResource SubPanelStyle}">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="LogText"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock
                Style="{StaticResource FieldHintTextStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                controls:Loc.Text="Eid.Hint.HoldFull" />
        </StackPanel>
    </Grid>
</ContentDialog>
