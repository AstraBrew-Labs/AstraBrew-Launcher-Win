<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AstraBrew_Launcher.Views.Controls.ExtensionInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="安装扩展"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="开始安装"
    mc:Ignorable="d">

    <Grid Width="470">
        <!--  ==================== 表单 ====================  -->
        <StackPanel x:Name="FormPanel" Spacing="14">

            <!--  安装方式：Git / 离线包，两条互斥路径；两段等宽，像分段控件  -->
            <Border Padding="4" Style="{StaticResource SubPanelStyle}">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton
                        x:Name="GitTab"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Checked="Tab_Checked"
                        GroupName="InstallTabs"
                        IsChecked="True"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE774;" />
                            <TextBlock Text="Git 仓库" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="OfflineTab"
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Checked="Tab_Checked"
                        GroupName="InstallTabs"
                        Style="{StaticResource TabStripRadioStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                            <TextBlock Text="离线包" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!--  Git 面板  -->
            <StackPanel x:Name="GitPanel" Spacing="8">
                <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="仓库地址" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="UrlBox"
                        PlaceholderText="https://github.com/用户/扩展.git"
                        TextChanged="UrlBox_TextChanged" />
                    <Button
                        x:Name="DetectButton"
                        Grid.Column="1"
                        Click="Detect_Click"
                        Content="检测分支" />
                </Grid>

                <TextBlock Style="{StaticResource FieldTitleTextStyle}" Text="分支" />
                <ComboBox
                    x:Name="BranchBox"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="先检测分支，再选择要安装的分支" />

                <TextBlock
                    Style="{StaticResource FieldHintTextStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="支持 GitHub、Gitee 的 HTTPS 地址；同名目录已存在时会被覆盖，扩展配置不保留。" />
            </StackPanel>

            <!--  离线面板  -->
            <StackPanel
                x:Name="OfflinePanel"
                Spacing="8"
                Visibility="Collapsed">
                <Button Click="PickOffline_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="12" Glyph="&#xE8E5;" />
                        <TextBlock Text="选择 .zip 离线包" />
                    </StackPanel>
                </Button>
                <Border Padding="12,10" Style="{StaticResource SubPanelStyle}">
                    <TextBlock
                        x:Name="OfflineText"
                        Style="{StaticResource FieldHintTextStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="尚未选择离线包" />
                </Border>
                <TextBlock
                    Style="{StaticResource FieldHintTextStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="离线包需包含 manifest.json；一次可选择多个，安装完成后统一启用。" />
            </StackPanel>

            <!--  校验提示放在两条路径之外，切 Tab 后仍然可见  -->
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource FieldHintTextStyle}"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  ==================== 安装进度 ====================  -->
        <StackPanel
            x:Name="ProgressPanel"
            Spacing="10"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="#1F2B88D8"
                    CornerRadius="6">
                    <FontIcon
                        FontSize="13"
                        Foreground="#FF2B88D8"
                        Glyph="&#xE72C;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="PhaseText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="正在克隆仓库…" />
                    <TextBlock
                        x:Name="PhaseHintText"
                        Style="{StaticResource MetaChipTextStyle}"
                        Text="第 1/2 步 · 下载扩展代码" />
                </StackPanel>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0%" />
            </Grid>

            <ProgressBar
                x:Name="InstallBar"
                Height="4"
                Maximum="100"
                Minimum="0"
                Value="0" />

            <Border Padding="12,10" Style="{StaticResource SubPanelStyle}">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="LogText"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock
                Style="{StaticResource FieldHintTextStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="安装期间请勿关闭窗口；完成后扩展会自动启用并出现在列表中。" />
        </StackPanel>
    </Grid>
</ContentDialog>
